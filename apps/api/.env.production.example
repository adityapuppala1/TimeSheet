# PRODUCTION environment profile — copy to apps/api/.env.production, fill in real values, then
# run with APP_ENV=production (see docs/DEPLOYMENT.md § Environment profiles).
#
# NOTE ON DOCKER: a Compose deployment installed via install.sh/install.cmd does NOT read this
# file — Compose injects env from the ROOT .env the installer generated. This profile is for
# running the API process directly against production infrastructure (bare-metal/PM2/systemd
# deployments, or a production-config rehearsal from a workstation).
#
# Everything here is deliberately strict: NODE_ENV=production turns on the boot-time
# secret-strength checks, and the server REFUSES placeholder secrets — filling this file
# sloppily fails fast instead of running insecurely.

NODE_ENV=production
TZ=Asia/Kolkata

DATABASE_URL="mysql://timesphere:CHANGE-ME@prod-db-host:3306/timesheet_portal"
CONTROL_DATABASE_URL="mysql://timesphere:CHANGE-ME@prod-db-host:3306/timesphere_control"

# openssl rand -base64 48 for each JWT secret; openssl rand -hex 32 for the encryption key.
# Rotating ENCRYPTION_KEY re-encrypts nothing by itself — treat it as write-once per deployment.
JWT_ACCESS_SECRET="CHANGE-ME"
JWT_REFRESH_SECRET="CHANGE-ME"
PLATFORM_ADMIN_JWT_SECRET="CHANGE-ME"
ENCRYPTION_KEY="CHANGE-ME-64-hex-chars"

# The real domain, over https — never "auto" in production: emailed links must not follow
# whatever address the box happens to hold.
WEB_ORIGIN="https://timesphere.example.com"
APP_BASE_URL="https://timesphere.example.com"

# The number of reverse proxies in front of this process. Present in THIS file specifically because
# a bare-metal/systemd/PM2 production deployment is the shape most likely to sit behind nginx or
# Apache — and the default of 0 is wrong for every one of them. At 0, Express reads req.ip as the
# PROXY's address for every caller on earth, so each per-IP rate limit (the 20/min login limiter
# above all) silently collapses into one shared global bucket that a single attacker can exhaust for
# everybody. It is a HOP COUNT, not a boolean, because trusting X-Forwarded-For wholesale lets any
# caller forge req.ip: nginx alone = 1, Cloudflare in front of nginx = 2.
# CAVEAT: with a hop count set, anything that can reach the API port DIRECTLY can forge the header.
# Bind the port to localhost so the only route in is through the proxy the count describes.
TRUST_PROXY_HOPS=1

# SSRF guard on the four admin-configurable outbound URLs (outbound webhooks, Google Chat webhook,
# Bot Framework replies, BYOK AI base URL). FALSE refuses private/loopback/link-local targets —
# most importantly 169.254.169.254, the cloud metadata service that issues IAM credentials.
# Keep it false on anything internet-facing; set true ONLY for an on-prem box whose webhook
# receivers really are on the LAN.
ALLOW_PRIVATE_NETWORK_EGRESS=false

# Raise this when many real users share ONE egress IP (office NAT, corporate proxy) — a 9am login
# rush across a hundred people behind one address exceeds the 900/min default easily, and they all
# start seeing 429s. The strict per-surface limiters are not affected by it.
# RATE_LIMIT_PER_MINUTE=900

# Single-org deployments should raise this from the code default of 5, which is multi-tenant
# arithmetic. Load testing measured 5 capping the authed path near 90 req/s on pool queueing alone.
# TENANT_DB_CONNECTION_LIMIT=20

MAIL_FROM="TimeSphere <no-reply@example.com>"
SMTP_HOST="smtp-relay.example.com"
SMTP_PORT=587
SMTP_USER="no-reply@example.com"
SMTP_PASS="CHANGE-ME"
SMTP_SECURE=false

# Only if the platform provisions new organizations in-app (SaaS shape); else leave unset.
# TENANT_DB_PROVISION_BASE_URL="mysql://timesphere:CHANGE-ME@prod-db-host:3306"

ANTHROPIC_API_KEY=""
