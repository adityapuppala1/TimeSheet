/// Control-plane schema — the platform's own database, separate from every tenant database.
/// WHAT: registry of organizations (tenants), each org's dedicated database connection,
/// per-org SSO configuration, platform-operator accounts, and plan-tier limits.
/// WHY a second, separate schema/database rather than a row inside a tenant database (or a
/// designated "org 0"): the control plane must stay reachable and typed independently of any
/// single tenant's database health, and keeping every tenant database schema-identical (no
/// extra platform-only tables in any one of them) is what makes provisioning/migration
/// automation simple. See apps/api/src/config/control-prisma.ts for the client, and
/// apps/api/src/config/tenant-context.ts for how a request's tenant database is resolved and
/// attached for the rest of that request — this schema only describes the control plane
/// itself, never ticket/timesheet/user content, which all lives per-tenant.
generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/control-client"
}

datasource db {
  provider = "mysql"
  url      = env("CONTROL_DATABASE_URL")
}

enum PlanTier {
  STARTER
  TEAM
  ENTERPRISE
}

enum OrgStatus {
  PROVISIONING
  ACTIVE
  /// The trial ended, or a renewal failed, and nobody has paid yet.
  ///
  /// DELIBERATELY BETWEEN ACTIVE AND SUSPENDED. A suspended workspace refuses every request at
  /// `resolveActiveOrgBySlug`, including sign-in — which also refuses the one person who can pay,
  /// on the day they decided to. GRACE keeps the door reachable and everything behind it shut:
  /// requests resolve, a SUPER_ADMIN can still sign in, and `requireAuth` refuses everyone else
  /// and every route except billing and export. The data is untouched throughout.
  GRACE
  SUSPENDED
  ARCHIVED
}

enum SsoProviderType {
  GOOGLE
  MICROSOFT
  SAML
  LDAP
}

/// One row per customer company. `slug` is the subdomain (`<slug>.timesphere.app`) used to
/// resolve which tenant database and SSO configuration a request belongs to, BEFORE the
/// request is authenticated (see tenant-context.ts).
model Organization {
  id       String    @id @default(uuid())
  name     String    @db.VarChar(200)
  slug     String    @unique @db.VarChar(63)
  status   OrgStatus @default(PROVISIONING)
  planTier PlanTier  @default(STARTER)

  /// Per-org overrides of the plan tier's defaults (see PlanTierLimit) — null means "use the
  /// tier default." Only a platform admin can set these (see Phase B6/B7).
  seatLimitOverride              Int?
  aiMonthlyBudgetCeilingOverride Decimal? @db.Decimal(10, 2)

  /// The GENERAL per-org escape from the tier defaults (5.0.0), as `{ "goalsEnabled": true }`.
  ///
  /// WHY A JSON COLUMN AND NOT TWENTY MORE `*Override` COLUMNS. The two above are the whole of the
  /// per-org escape hatch, and they cover seats and AI budget. Everything else — every planning
  /// capability, every quota, face verification — had no escape at all, so enabling one beta for
  /// one design partner meant moving their entire tier and quietly handing them nine other
  /// features nobody agreed to. A column per entitlement would be a migration every time a
  /// capability is added, which is the reason the escape never got built.
  ///
  /// KEYS ARE AN ALLOWLIST, NOT FREE TEXT. `services/platform-feature-overrides.service.ts` owns
  /// the set, and a key outside it is DROPPED on read rather than honoured — a typo, or a key from
  /// a build that has been rolled back, must not silently entitle anybody.
  ///
  /// SEATS AND AI BUDGET ARE DELIBERATELY NOT OVERRIDABLE HERE. They already have their own
  /// columns, read by `plan-limits.service.ts`, and a second place to set the same number is a bug
  /// waiting for the day the two disagree.
  ///
  /// AN OVERRIDE THAT GRANTS BEYOND THE PLAN IS A DECISION, NOT A SETTING. The route that writes
  /// this refuses a body that grants a capability the tier forbids unless the operator explicitly
  /// acknowledges that is what they are doing, and the `platformAudit` row names every granting key.
  featureOverrides               Json?

  /// Self-serve billing (see docs/ROADMAP.md's "Monetization readiness" theme and
  /// billing.controller.ts) — set once the org's own SUPER_ADMIN completes a Stripe Checkout
  /// session. Null for every org that's never gone through checkout (manually-provisioned or
  /// still on STARTER), which is the common case today. One Stripe customer per org, one active
  /// subscription per org — this app doesn't support multiple concurrent subscriptions per org.
  stripeCustomerId     String? @unique @db.VarChar(255)
  stripeSubscriptionId String? @unique @db.VarChar(255)

  /// --- What Stripe says this workspace actually pays (5.1.0) --------------------------------
  ///
  /// WHY THESE COLUMNS EXIST. Every revenue figure in the console is LIST PRICE — what the plan
  /// advertises, from `PlanTierLimit.listPricePerSeatMinor` — and it is labelled as such
  /// everywhere. The number an operator actually wants is the GAP between that and what customers
  /// are billed, because that gap is the discounting nobody decided to standardise. Stripe knows
  /// the billed amount; the console cannot ask it on every page render without turning a screen
  /// somebody refreshes into a rate limit. So the answer is written down HERE by
  /// `workers/billed-revenue-reconcile.worker.ts` and read from here.
  ///
  /// NULLABLE THROUGHOUT, AND NULL IS NOT ZERO. A workspace with no Stripe subscription simply has
  /// none of this, and that is the common case rather than an error. A workspace whose
  /// reconciliation has never run has `billedReconciledAt` null, and the console says "not
  /// reconciled yet" instead of showing a gap of zero — the two sentences mean opposite things.
  ///
  /// `billedMrrMinor` IS ALWAYS A MONTHLY FIGURE, normalised from whatever interval the
  /// subscription actually bills on. An annual subscription stored at its full yearly amount would
  /// report twelve times the truth, which is the easiest way for this whole feature to be
  /// confidently wrong; `subscriptionMonthlyMinor` in the reconcile service owns that division.
  billedMrrMinor             Int?
  billedCurrency             String?   @db.VarChar(3)
  /// The subscription the figure came from. Kept beside the amount rather than assumed equal to
  /// `stripeSubscriptionId`, so a figure reconciled before a resubscribe is visibly stale rather
  /// than silently attributed to a subscription it never described.
  billedSubscriptionId       String?   @db.VarChar(255)
  /// When a reconciliation last SUCCEEDED. Null means the figure above is absent, never zero.
  billedReconciledAt         DateTime?
  /// When one was last ATTEMPTED, success or failure — the two are separate so a run that failed
  /// cannot look like one that never happened.
  billedReconcileAttemptedAt DateTime?
  /// The last failure, cleared on the next success. A workspace carrying one is counted and NAMED
  /// separately in the console rather than folded into the total as zero: a Stripe outage must not
  /// read as a 100% discount.
  billedReconcileError       String?   @db.VarChar(500)

  /// Free-trial clock. Null on every workspace a platform admin provisioned by hand, which is how
  /// every existing org was created — a null `trialEndsAt` means "no trial", never "expired".
  trialStartedAt DateTime?
  trialEndsAt    DateTime?
  /// The tier a trialling workspace is ENTITLED to, which is not `planTier`.
  ///
  /// Kept separate on purpose: `planTier` is what the workspace has PAID for, and writing the trial
  /// tier into it would mean an expiring trial has to guess what to downgrade to, and a Stripe
  /// webhook arriving mid-trial has nothing to compare against. `plan-limits.service.ts` resolves
  /// the effective tier from both, so every existing entitlement check inherits trials with no
  /// caller changes at all.
  trialTier      PlanTier?

  /// Which lifecycle warnings have already gone out, as days-before-expiry (`[7, 3, 1]`).
  /// The worker runs daily and must be idempotent: without this it re-sends every warning on every
  /// run, and a customer gets seven copies of "your trial ends in 7 days".
  trialNoticesSent Json?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  suspendedAt     DateTime?
  suspendedReason String?   @db.Text
  /// When the workspace entered GRACE — the clock the suspension deadline is measured from.
  graceStartedAt  DateTime?

  /// --- Trial retention programme (3.12.0) ---------------------------------------------------
  /// The address the workspace was signed up (or provisioned) with. Kept HERE, in the control
  /// plane, because the retention emails have to reach somebody after the workspace is suspended
  /// — and after it is deleted, for the confirmation. Reading super admins out of a tenant
  /// database that is about to be dropped is the wrong dependency direction. Null on every org
  /// created before this column existed; the worker falls back to the tenant's super admins then.
  ownerEmail           String?   @db.VarChar(255)
  /// Day markers already sent — `["feedback10", "ended", "30", "60", "80", "90"]`. Same
  /// idempotence rule as `trialNoticesSent`: recorded even when the mail failed, so a broken
  /// relay does not turn into a daily copy of the same reminder.
  retentionNoticesSent Json?
  /// A platform admin's "do not delete this one" — set while a conversation is in progress. The
  /// reminders still go; only the deletion is held.
  retentionHold        Boolean   @default(false)
  /// When the physical database was dropped under the policy. The org row stays, ARCHIVED, so the
  /// slug is not silently re-issued and the audit trail survives its subject.
  retentionDeletedAt   DateTime?

  database           OrgDatabase?
  ssoConfigs         OrgSsoConfig[]
  authMethod         OrgAuthMethod?
  directory          OrgUserDirectory[]
  domains            OrgDomain[]
  feedback           TrialFeedback[]
  platformEmails     PlatformEmailLog[]
  backupPolicy       OrgBackupPolicy?
  backupDestinations BackupDestination[]
  backupRuns         BackupRun[]
  dbSamples          TenantDbSample[]
  aiAdvice           PlatformAiAdvice[]
  usageSnapshots     OrgUsageSnapshot[]
  alertStates        PlatformAlertState[]

  @@index([status])
}

/// Platform-level SMTP — the account the DEPLOYMENT sends from, as opposed to the per-workspace
/// `GlobalMailSettings` every tenant carries. Signup codes, the trial retention programme and
/// anything else sent to somebody whose workspace is suspended or gone all use this. Same
/// "database row, else `SMTP_*` env" resolution as the tenant transport, so an env-only install
/// keeps working untouched. `id` is always "global".
model PlatformMailSettings {
  id                String   @id
  host              String?  @db.VarChar(255)
  port              Int      @default(587)
  secure            Boolean  @default(false)
  user              String?  @db.VarChar(255)
  encryptedPassword String?  @db.Text
  fromAddress       String?  @db.VarChar(255)
  replyTo           String?  @db.VarChar(255)
  /// Where a `sales.lead` notification is delivered. It lives HERE rather than as a constant at the
  /// send site because the inbox a deployment wants sales enquiries in is a per-deployment fact,
  /// not a property of the product — a self-hosted install's sales address is not ours. Null means
  /// "use the shipped default" (services/sales-lead.service.ts#DEFAULT_SALES_INBOX), so the form
  /// works on day one and is still reconfigurable without a redeploy.
  salesInboxAddress String?  @db.VarChar(255)
  updatedAt         DateTime @updatedAt
}

/// A platform admin's override of one shipped platform email (subject + body with `{{vars}}`).
/// No row means "send the shipped default" — exactly the tenant `EmailTemplate` contract, so the
/// console editor can be the same shape as the workspace one.
model PlatformEmailTemplate {
  key         String   @id @db.VarChar(80)
  subject     String   @db.VarChar(255)
  bodyHtml    String   @db.Text
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  updatedById String?
}

enum PlatformEmailStatus {
  SENT
  FAILED
  SKIPPED
}

/// Every platform-level email, one row each — the analytics, the per-template log and the resend
/// button all read this. `dayMarker` is the retention stage ("feedback10", "30", …) so the queue
/// can show which reminders a workspace has had; `isTest` keeps operator test sends out of the
/// delivery numbers without hiding them from the log.
model PlatformEmailLog {
  id             String              @id @default(uuid())
  organizationId String?
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  templateKey    String              @db.VarChar(80)
  to             String              @db.VarChar(255)
  subject        String              @db.VarChar(255)
  status         PlatformEmailStatus
  errorMessage   String?             @db.Text
  dayMarker      String?             @db.VarChar(24)
  isTest         Boolean             @default(false)
  /// The rendered message, kept so a FAILED row can be resent exactly as it was. `{ html }`, plus
  /// `replyTo` when the message named a per-message reply address (a sales-lead notification
  /// replies to the prospect, not to the deployment) — that is part of "as it was" and has no
  /// column of its own on purpose. Older rows carry `{ html }` alone and resend without one.
  payload        Json?
  metadata       Json?
  createdAt      DateTime            @default(now())

  @@index([templateKey, createdAt])
  @@index([organizationId, createdAt])
  @@index([status, createdAt])
}

/// The retention policy a platform admin controls. `id` is always "global". Defaults mirror the
/// programme as specified: feedback on day 10 of the trial, reminders 30/60/80/90 days after it
/// ends, deletion after 90 days. `autoDeleteEnabled` is the kill switch; `enabled` silences the
/// whole programme (the tenant-side trial emails then carry on exactly as before 3.12.0).
model PlatformRetentionSettings {
  id                String   @id
  enabled           Boolean  @default(true)
  feedbackDay       Int      @default(10)
  reminderDays      Json     @default("[30, 60, 80, 90]")
  retentionDays     Int      @default(90)
  autoDeleteEnabled Boolean  @default(true)
  /// Where a best-effort `mysqldump` of a workspace is written before it is dropped. Null means
  /// "do not snapshot". A missing `mysqldump` binary is recorded, never fatal.
  snapshotDir       String?  @db.VarChar(500)
  updatedAt         DateTime @updatedAt
}

/// What a trialling (or lapsed) customer told us through the feedback form the programme mails.
/// `stage` is the marker that produced the link, so day-10 impressions and post-trial reasons can
/// be read apart.
model TrialFeedback {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stage          String       @db.VarChar(24)
  rating         Int
  liked          String?      @db.Text
  missing        String?      @db.Text
  wouldReturn    String?      @db.VarChar(16)
  comment        String?      @db.Text
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

/// Somebody who asked to talk to us through the public contact form, and where that conversation
/// got to.
///
/// WHY THE CONTROL PLANE AND NOT A TENANT: a lead has no workspace. That is the whole point of one
/// — the person filling the form is deciding whether to become a customer, so there is no tenant
/// database to write to and no `resolveTenant` that could find one. Deliberately NO relation to
/// `Organization` for the same reason (the same shape as `PlatformMailSettings`): if a lead ever
/// does become a workspace, the link worth having is the audit trail, not a foreign key that would
/// be null for every row that matters most.
///
/// `interests` is JSON because it is a multi-select whose options are a marketing decision that
/// changes faster than a migration should. Everything else that looks like an enum is a short
/// string, exactly like `TrialFeedback.stage`: these are values a sales process renames, and
/// renaming a MySQL enum is a table rewrite.
///
/// `isFreeMailDomain` is a FLAG, never a gate. Signup refuses a free-mail address because a trial
/// is per organisation; a sales enquiry from a founder's Gmail is a real lead, and refusing it
/// would lose the enquiry to protect nothing. See services/sales-lead.service.ts.
model SalesLead {
  id String @id @default(uuid())

  // Who they are.
  name    String  @db.VarChar(255)
  email   String  @db.VarChar(255)
  company String  @db.VarChar(255)
  role    String? @db.VarChar(120)
  country String? @db.VarChar(120)
  phone   String? @db.VarChar(40)

  // What they are asking for — the qualification block the notification email leads with.
  teamSize           String @db.VarChar(24)
  deploymentInterest String @db.VarChar(24)
  timeline           String @db.VarChar(24)
  interests          Json
  message            String @db.Text

  /// Free-mail address: shown in the console, never acted on by the server.
  isFreeMailDomain Boolean @default(false)

  // Where the enquiry came from. Captured because "which page and which campaign produces leads
  // that close" is the only question the marketing pages can be judged on, and it cannot be
  // reconstructed later from the row itself.
  sourcePage  String? @db.VarChar(255)
  referrer    String? @db.VarChar(500)
  utmSource   String? @db.VarChar(120)
  utmMedium   String? @db.VarChar(120)
  utmCampaign String? @db.VarChar(120)

  // The pipeline. Owned by a human in the console; nothing here is ever set by the public route
  // except the initial NEW.
  status      String    @default("NEW") @db.VarChar(16)
  ownerLabel  String?   @db.VarChar(255)
  notes       String?   @db.Text
  contactedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

/// The control plane's own audit trail — who provisioned, rescued, held, deleted, changed a tier.
/// Tenant audit logs live in tenant databases and cannot record an action taken ON the tenant
/// from outside it; this is where those go. Never contains tenant content.
model PlatformAuditLog {
  id         String   @id @default(uuid())
  actorType  String   @db.VarChar(24)
  actorLabel String?  @db.VarChar(255)
  action     String   @db.VarChar(80)
  entity     String   @db.VarChar(40)
  entityId   String?  @db.VarChar(64)
  metadata   Json?
  createdAt  DateTime @default(now())

  /// WHY the operator says they did it. The tenant `AuditLog` grew `before`/`after` because "an
  /// autonomous change nobody can reconstruct is an autonomous change nobody can review"; this
  /// column exists for the harder half of the same problem. The control plane's rows record an
  /// action taken ON a customer from outside their workspace, where the customer cannot see the
  /// context and the reviewer six months later has no ticket to read. A free-text line typed at
  /// the moment of the action is the only thing that survives.
  ///
  /// Nullable, because the routes that require one enforce it at the door (middleware
  /// `requirePlatformReason`) and the rows written by workers and by the customer themselves
  /// genuinely have no operator to ask.
  reason String? @db.Text

  /// The state that changed, same contract and same reasoning as the tenant AuditLog's pair:
  /// `metadata` is freeform and every call site invented its own shape, so it can describe an
  /// action but cannot be diffed.
  before Json?
  after  Json?

  /// The column the tenant AuditLog has had since its first migration and never wrote. Here it is
  /// written from the start: an administrative change made across tenant boundaries is exactly the
  /// row where "from where" matters.
  ipAddress String? @db.VarChar(64)

  @@index([createdAt])
  @@index([entity, entityId])
}

/// An irreversible console action, queued for a second operator to countersign.
///
/// WHY REPLAY AND NOT A FLAG. The obvious design is a boolean on the target ("approved: true") that
/// the destructive service checks. That fails the moment the world moves between the request and
/// the approval: an org that started paying, a snapshot that has since been deleted, a tier that
/// changed. Storing the REQUEST — the route, its params and its body — and re-running the ordinary
/// handler on approval means every guard the handler already has runs again, against the database
/// as it is at approval time. An approval is therefore a decision to run the action now, not a
/// stored decision replayed blind. Nothing in the destructive services changed to support this;
/// they already take `(id…, { actorLabel })` and re-derive everything else themselves.
///
/// `params`/`body` are JSON rather than columns because five different actions have five different
/// shapes, and the only consumer is the executor registered for `action`, which validates them.
model PendingPlatformAction {
  id String @id @default(uuid())

  /// One of `@timesheet/shared`'s `platformTwoPersonActions`. VARCHAR, not an ENUM — same reason
  /// as everywhere else in this schema.
  action String @db.VarChar(40)
  /// Recorded for the console and the audit trail. The executor is looked up by `action`, never by
  /// this — a stored path must not be able to choose which code runs.
  route  String @db.VarChar(255)
  method String @db.VarChar(8)
  params Json
  body   Json

  /// Required. A request nobody explained is a request nobody can approve.
  reason String @db.Text

  requestedById    String
  requestedByLabel String   @db.VarChar(255)
  requestedAt      DateTime @default(now())
  requestedIp      String?  @db.VarChar(64)

  /// PENDING | APPROVED | REJECTED | EXPIRED | FAILED.
  status String @default("PENDING") @db.VarChar(16)

  /// Never equal to `requestedById`: the whole guarantee is that two people were involved, and a
  /// two-person rule one person can satisfy alone is decoration. Enforced in the service, not by a
  /// constraint, because the check needs to produce an explanation.
  approvedById    String?
  approvedByLabel String?   @db.VarChar(255)
  approvedAt      DateTime?

  /// Why it was refused, or what went wrong when the replayed handler threw. A queue that silently
  /// swallows failures is a queue that quietly does nothing.
  resolutionNote String? @db.Text

  /// After this, the request can only be read, never approved. See PLATFORM_APPROVAL_TTL_HOURS.
  expiresAt DateTime

  @@index([status, expiresAt])
  @@index([requestedById])
}

/// The physical database a tenant's data lives in. `encryptedDsn` uses the same AES-256-GCM
/// helper already used for GlobalAISettings.apiKey / EmailIntakeSettings.imapPassword
/// (apps/api/src/utils/encryption.ts) — decrypted only inside the tenant-Prisma-client
/// factory, never logged, never returned by any API response.
model OrgDatabase {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  encryptedDsn String @db.Text
  /// Plaintext host/database name kept alongside the encrypted DSN purely for ops
  /// dashboards/monitoring — never enough on its own to connect.
  host         String @db.VarChar(255)
  databaseName String @db.VarChar(128)

  migratedAt    DateTime?
  /// Name of the last tenant migration applied — compared against the latest migration in
  /// apps/api/prisma/migrations to detect a tenant that's drifted behind on schema.
  schemaVersion String?   @db.VarChar(160)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Per-org, per-provider-type SSO configuration — an org has 0-3 rows, one per provider type
/// it has configured. `encryptedClientSecret` reuses utils/encryption.ts; `idpCertificate` is
/// the IdP's PUBLIC signing certificate for SAML, not a secret, so it's stored plaintext.
model OrgSsoConfig {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerType   SsoProviderType
  isEnabled      Boolean         @default(false)

  // OIDC (GOOGLE / MICROSOFT) — each org registers its own OAuth app with the provider.
  clientId              String? @db.VarChar(255)
  encryptedClientSecret String? @db.Text
  /// Azure AD tenant ID — MICROSOFT only.
  tenantHint            String? @db.VarChar(255)

  // SAML
  idpEntityId    String? @db.VarChar(500)
  idpSsoUrl      String? @db.VarChar(500)
  idpCertificate String? @db.Text
  /// This app's own per-org SP entity ID, since each org's IdP admin configures a relationship
  /// uniquely to "their" SP entry even though it's the same running application.
  spEntityId     String? @db.VarChar(500)

  // LDAP / Active Directory — a direct bind, not a redirect, so there's no client secret to
  // encrypt in the OIDC sense; the service-account bind credential plays that role instead.
  ldapUrl                     String? @db.VarChar(500)
  ldapBindDn                  String? @db.VarChar(500)
  encryptedLdapBindCredential String? @db.Text
  ldapSearchBase              String? @db.VarChar(500)
  /// Template with a `{{email}}` placeholder substituted at auth time, e.g. `(mail={{email}})`.
  ldapUserFilter              String? @db.VarChar(255)
  ldapTlsRejectUnauthorized   Boolean @default(true)

  /// Result of the last connection test (see services/sso-validation.service.ts). Recorded, not
  /// enforced: an IdP behind a corporate firewall can be unreachable from this server and still be
  /// correctly configured, so a failing test must never block a save. What it DOES gate is
  /// `OrgAuthMethod.requireSsoOnly` — turning off password login for a whole workspace on a
  /// configuration nobody has ever proven works is how a workspace locks itself out.
  lastTestedAt    DateTime?
  /// "PASS" | "FAIL" — null means never tested, which is a state the settings card shows.
  lastTestStatus  String?   @db.VarChar(16)
  lastTestMessage String?   @db.Text

  /// When a real person last completed a sign-in through this provider.
  ///
  /// THIS, NOT THE CONNECTION TEST, IS WHAT GATES `OrgAuthMethod.requireSsoOnly`. The test was
  /// built for that job first and could not do it: Azure AD answers a token-endpoint probe with
  /// `invalid_grant` (AADSTS9002313) before it ever looks at the client credentials, so a
  /// Microsoft config holding two junk strings tested green. A completed sign-in cannot be faked
  /// by a misread error code — it means a human reached the IdP, authenticated, came back, and
  /// got a session. That is the only evidence that actually predicts "will people still be able
  /// to get in after I turn off passwords", which is the question the switch is asking.
  lastSuccessfulLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, providerType])
}

/// Fast, single-row-read login-method policy — kept separate from OrgSsoConfig so "is
/// password login even allowed for this org" doesn't require joining/filtering three SSO rows
/// on every login attempt.
model OrgAuthMethod {
  id                   String       @id @default(uuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  passwordLoginEnabled Boolean      @default(true)
  /// When true, password login is force-disabled regardless of passwordLoginEnabled — an org
  /// can require SSO-only.
  requireSsoOnly       Boolean      @default(false)
  updatedAt            DateTime     @updatedAt
}

/// Which workspaces an email address can sign in to — the index behind "find my workspaces".
///
/// WHY IT HAS TO EXIST AT ALL. Every tenant's users live in a physically different database, so
/// "which workspaces is this address in?" is a cross-tenant question that no tenant database can
/// answer and the control plane previously had no way to. Without this table the only way to reach
/// a workspace is to already know its subdomain.
///
/// WHY IT STORES A HASH AND NOT THE ADDRESS. The control plane holds the org registry, the plan
/// matrix and every tenant's database credentials. Adding a plaintext list of every user's email
/// across every customer would turn one dump of it into a customer list AND a marketing list — a
/// materially worse breach than the one it already represents. An HMAC (keyed with the app's own
/// secret, so it is not a rainbow-table lookup either) answers the only question this table is
/// asked — "does the address someone just typed match this row?" — and answers nothing else. It
/// deliberately cannot be enumerated, reversed, or exported as addresses.
model OrgUserDirectory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// HMAC-SHA256 of the lowercased, trimmed address. See utils/directory-hash.ts.
  emailHash String @db.Char(64)

  /// Refreshed on each sign-in, so a workspace nobody has used in years can be aged out later
  /// without guessing. Not shown to anyone.
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([organizationId, emailHash])
  /// The lookup this table exists for: one address, every workspace it belongs to.
  @@index([emailHash])
}

/// A custom domain pointed at one workspace — `time.acme.com` instead of `acme.timesphere.app`.
///
/// Verification is a DNS TXT record rather than a file upload or an email click, because the
/// question being answered is "does this person control this domain", and DNS is the only one of
/// the three that actually asks it. An unverified row is inert: `resolveOrgSlug` ignores it, so
/// claiming someone else's domain gains nothing while it stays unverified.
model OrgDomain {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Lowercased hostname, no scheme, no port, no trailing dot.
  domain String @unique @db.VarChar(253)

  /// The value the customer publishes at `_timesphere-verify.<domain>`.
  verificationToken String    @db.VarChar(64)
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  lastCheckError    String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

/// Platform-operator accounts — deliberately a completely separate table/auth path from any
/// tenant User. A compromised tenant database can never yield platform-admin credentials,
/// since platform admins don't exist in any tenant database at all.
model PlatformAdminUser {
  id           String              @id @default(uuid())
  email        String              @unique @db.VarChar(255)
  passwordHash String
  name         String              @db.VarChar(120)
  status       PlatformAdminStatus @default(ACTIVE)
  createdAt    DateTime            @default(now())
  lastLoginAt  DateTime?

  /// Which of `@timesheet/shared`'s `platformRoles` this operator holds. VARCHAR, not a MySQL
  /// ENUM, for the reason stated all over this schema: renaming an ENUM value is a table rewrite.
  ///
  /// THE DEFAULT IS THE RESTRICTIVE ONE, AND THE MIGRATION MUST CONTRADICT IT. A column added by
  /// migration has to default to the least power, because a row that misses its initialisation
  /// should be under-privileged rather than over-privileged — the same rule `PlanTierLimit`'s
  /// entitlement blocks state. But `prisma/control/seed.ts` creates the bootstrap admin with an
  /// upsert whose `update` branch is `{}`, and the seed never re-runs on upgrade. So on every
  /// existing install this default would silently demote the only account that can reach the
  /// console — including the one running the upgrade — and there would be nobody left able to
  /// promote anyone. The migration that introduces this column therefore carries idempotent SQL
  /// promoting every pre-existing admin to OWNER: they already had unrestricted power, and an
  /// upgrade must preserve what people had, not quietly take it away.
  role String @default("READ_ONLY") @db.VarChar(16)

  /// --- Second factor ---------------------------------------------------------------------
  /// TOTP (RFC 6238), verified in-house — see utils/totp.ts for why there is no dependency here.
  ///
  /// `mfaEnabled` is the gate; `mfaSecret` is the shared secret, stored with
  /// utils/encryption.ts#encryptSecret (AES-256-GCM) because unlike a password it MUST be read
  /// back to verify a code. A secret is written at enrolment and only becomes live once the
  /// operator has proved they can generate a code from it — enrolling somebody into a factor
  /// they cannot produce is how a console locks out its own owner.
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?   @db.Text
  mfaEnrolledAt DateTime?

  /// The last 30-second time step this account successfully consumed. A TOTP code stays valid for
  /// its whole step (plus the skew window), so without this a code observed in transit — over the
  /// operator's shoulder, in a screen share, in a proxy log — can be replayed for up to a minute.
  /// Refusing any step at or below the last one used costs one column and closes that window.
  mfaLastUsedStep BigInt?

  sessions      PlatformAdminSession[]
  recoveryCodes PlatformAdminRecoveryCode[]
}

/// A single-use way back in when the authenticator is gone — a lost phone must not mean a lost
/// console.
///
/// HASHED, NOT ENCRYPTED. `mfaSecret` above is encrypted because the server has to read it back to
/// compute a code. A recovery code is the opposite: it is only ever COMPARED against what somebody
/// typed, exactly like a password or a refresh secret, so it is stored with utils/security.ts's
/// `hashToken` and is unreadable even to us. One row per code rather than a JSON array, so
/// "consume exactly one, atomically" is an UPDATE with a WHERE rather than a read-modify-write two
/// sign-ins can race.
model PlatformAdminRecoveryCode {
  id          String            @id @default(uuid())
  adminUserId String
  adminUser   PlatformAdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  codeHash    String
  usedAt      DateTime?
  createdAt   DateTime          @default(now())

  @@index([adminUserId, usedAt])
}

enum PlatformAdminStatus {
  ACTIVE
  INACTIVE
}

/// Same rotation/reuse-detection shape as the tenant Session model
/// (apps/api/prisma/schema.prisma's Session) — reused deliberately so
/// auth.service.ts#refresh's logic can be mirrored rather than reinvented for platform admins.
model PlatformAdminSession {
  id                  String            @id @default(uuid())
  adminUserId         String
  adminUser           PlatformAdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  refreshHash         String
  previousRefreshHash String?
  refreshRotatedAt    DateTime?
  userAgent           String?
  ipAddress           String?
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime          @default(now())

  @@index([adminUserId, expiresAt])
}

/// Static per-tier defaults. Modeled as a table (seeded once, see prisma/control/seed.ts)
/// rather than a hardcoded config object so a platform admin can tune limits without a
/// deploy. `PlatformBillingSettings` below maps each paid tier to a Stripe Price ID for the
/// self-serve checkout flow (billing.controller.ts) — a platform admin can still assign/override
/// a tier by hand (the original flow) for orgs that never go through Stripe at all.
model PlanTierLimit {
  tier                      PlanTier @id
  seatLimit                 Int
  aiMonthlyBudgetCeilingUsd Decimal  @db.Decimal(10, 2)
  /// Which SSO provider types this tier is even allowed to configure, e.g. Starter might only
  /// get GOOGLE while Enterprise gets all four.
  allowedSsoProviders       Json
  /// Which chat platforms (Slack/Microsoft Teams/Google Chat/Telegram) this tier may connect —
  /// same enable-gate pattern as allowedSsoProviders, checked in chat-integrations.controller.ts.
  allowedChatPlatforms      Json     @default("[]")
  /// Whether this tier may use face (identity) verification — Enterprise-only by seed default.
  /// Enabling/enrolling/verifying fail CLOSED against this; enforcement on submissions fails
  /// OPEN (see face.service.ts#isFaceVerificationRequired) so a downgraded/lapsed org's staff
  /// are never locked out of logging their own time by a billing change.
  faceVerificationEnabled   Boolean  @default(false)

  /// --- Planning layer (V6) -------------------------------------------------------------------
  /// Every one of these defaults to the RESTRICTIVE value (false / 0). That is deliberate and is
  /// the safe direction for a column added by migration: a tier row that exists but has not yet
  /// been re-seeded is under-entitled rather than over-entitled, so the worst case is an admin
  /// seeing "upgrade to use this" for a moment, not a Starter org quietly getting Enterprise
  /// features. The migration that adds them also runs a guarded UPDATE to set the real
  /// Team/Enterprise values from @timesheet/shared's PLAN_TIER_LIMITS.
  ///
  /// All of these fail CLOSED, matching faceVerificationEnabled: the capability is refused unless
  /// the tier grants it. The counts are creation ceilings; 0 means the tier cannot use the
  /// feature at all.
  ganttEnabled           Boolean @default(false)
  resourceMgmtEnabled    Boolean @default(false)
  approvalsEnabled       Boolean @default(false)
  proofingEnabled        Boolean @default(false)
  customWorkflowsEnabled Boolean @default(false)
  /// Whether the AI PM copilot family exists for this tier. Spend is still bounded by
  /// aiMonthlyBudgetCeilingUsd above — this only decides whether the features are offered.
  aiPmCopilotEnabled     Boolean @default(false)
  maxPortfolios          Int     @default(0)
  maxRequestForms        Int     @default(0)
  maxBlueprints          Int     @default(0)
  maxCustomFields        Int     @default(0)
  maxDashboards          Int     @default(0)

  /// --- Goals / OKRs (V8 phase 1) -----------------------------------------------------------
  /// Same restrictive-default rule as the V6 block above, same reason: a tier row that misses
  /// its initialisation under-entitles, and the migration that adds these runs the guarded
  /// UPDATE with the real Team/Enterprise values from @timesheet/shared's PLAN_TIER_LIMITS.
  goalsEnabled Boolean @default(false)
  maxGoals     Int     @default(0)

  /// --- Change management (V8 phase 11) -----------------------------------------------------
  /// Same restrictive-default rule as every block above: a tier row that misses its initialisation
  /// under-entitles rather than over-entitles, and the migration that adds these runs the guarded
  /// UPDATE with the real Team/Enterprise values from @timesheet/shared's PLAN_TIER_LIMITS.
  changeManagementEnabled Boolean @default(false)
  /// Ceiling on approval POLICIES, not on changes — a workspace should never be unable to record a
  /// change it actually made because it hit a plan limit. 0 = the tier cannot use the module.
  maxChangePolicies       Int     @default(0)

  /// --- Managed backups (3.14.0) --------------------------------------------------------------
  /// The most frequent AUTOMATIC backup this tier may schedule. `NONE` means the tier cannot use
  /// the backup module at all, which is Starter's default — the same restrictive-default rule as
  /// every capability above, for the same reason: a tier row that misses its initialisation
  /// under-entitles rather than over-entitles.
  ///
  /// It is a CEILING, not a setting. A per-organization policy chooses its own cadence and the
  /// server clamps it to this — so a workspace on Team cannot be configured hourly even by a
  /// platform admin, because that is what the tier means.
  backupFrequency       BackupFrequency @default(NONE)
  /// How many destinations a tier may have configured at once. 0 pairs with `NONE`.
  maxBackupDestinations Int             @default(0)
  /// Test restores and point-in-time recovery. Gated separately from the schedule because it is
  /// the expensive half: a test restore materialises a whole database somewhere.
  backupPitrEnabled     Boolean         @default(false)

  /// --- Weekly AI/ML Practice Update (3.5.0) -------------------------------------------------
  /// Same restrictive-default rule as every block above. Gated for what the artefact CONTAINS —
  /// one document rolling up every project, everyone's hours and every open security finding, then
  /// mailed to addresses with no account here — rather than for what it costs to produce.
  practiceUpdateEnabled Boolean @default(false)

  /// --- List price (5.0.0) ------------------------------------------------------------------
  /// What a seat on this tier COSTS, per month, in minor units of `listPriceCurrency`.
  ///
  /// WHY IT IS HERE AT ALL: until 5.0.0 no price existed anywhere in this database.
  /// `PlatformBillingSettings` holds Stripe Price IDs, whose amounts live in Stripe, and the very
  /// common deployment that assigns tiers by hand has no Stripe account at all. So the console
  /// could report seats, tickets and AI spend and could not report a single unit of revenue.
  ///
  /// NULLABLE, AND NULL IS NOT ZERO. Null means "this tier has no list price" — Enterprise, which
  /// is priced per contract. A null must never be rendered or summed as 0: an operator who reads a
  /// confident $0 next to their largest customers will quote that number to somebody. The console
  /// shows "Not set", excludes those workspaces from the MRR total, and says how many it excluded.
  ///
  /// IT IS A LIST PRICE, NOT BILLED REVENUE. A discount, an annual commitment or a negotiated
  /// contract all differ from it. Seeded from `PLAN_TIER_LIST_PRICES` in @timesheet/shared, which
  /// is the same constant the landing page's pricing cards render — so the page and the operator's
  /// own MRR cannot disagree about what a seat costs.
  listPricePerSeatMinor Int?
  /// ISO-4217, one currency per deployment. VARCHAR rather than an enum for the reason every
  /// enum-shaped column in this schema is: renaming a MySQL ENUM is a table rewrite.
  listPriceCurrency     String @default("USD") @db.VarChar(3)
}

/// Platform-wide Stripe configuration (id = "global") — one Stripe account across every org on
/// this deployment, not BYOK per-org (unlike SSO/GitHub/Calendar, billing is TimeSphere's own
/// merchant-of-record relationship, not something each customer brings their own credentials
/// for). `encryptedSecretKey`/`encryptedWebhookSigningSecret` use the same AES-256-GCM helper as
/// every other secret in this app. `priceIdTeam`/`priceIdEnterprise` map this app's two paid
/// PlanTiers to the Stripe Price objects a platform admin creates in the Stripe dashboard —
/// billing.controller.ts's webhook handler reads a completed session's price ID back through
/// this same mapping to know which tier to set on Organization.planTier.
model PlatformBillingSettings {
  id                            String   @id
  encryptedSecretKey            String?
  encryptedWebhookSigningSecret String?
  priceIdTeam                   String?  @db.VarChar(255)
  priceIdEnterprise             String?  @db.VarChar(255)
  updatedAt                     DateTime @updatedAt
}

/// How often a workspace's database is backed up automatically. Ordered from least to most
/// frequent; `backupFrequencyRank` in the API compares them, so the ORDER of these members is not
/// load-bearing — the rank map is.
enum BackupFrequency {
  NONE
  WEEKLY
  DAILY
  HOURLY
}

/// Where a backup is written. LOCAL is the filesystem of the API host, which is the only one that
/// needs no credentials and the only one that is NOT off-site — it is offered because a
/// single-server on-prem install is a real deployment, and stated as what it is on the screen.
enum BackupDestinationKind {
  LOCAL
  S3
  AZURE_BLOB
  GOOGLE_DRIVE
  ONEDRIVE
  SFTP
}

enum BackupRetentionMode {
  /// Keep the newest N.
  COUNT
  /// Keep everything younger than N days.
  AGE
  /// Grandfather-Father-Son: N dailies, N weeklies, N monthlies, N yearlies.
  GFS
}

enum BackupRunKind {
  SCHEDULED
  MANUAL
  /// The snapshot the retention programme takes immediately before deleting a workspace.
  PRE_DELETE
  /// A restore into a scratch database, to prove the backup is readable. Never touches the tenant.
  TEST_RESTORE
}

enum BackupRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  /// Nothing was attempted — no destination, no entitlement, or the tier forbids the cadence.
  SKIPPED
}

/// A place backups are written to.
///
/// SCOPE. `organizationId` null means the destination belongs to the PLATFORM and any workspace's
/// policy may point at it — which is how a single operator-owned bucket serves every tenant, with
/// each workspace's objects under its own key prefix. A non-null one belongs to that customer
/// alone (an enterprise writing into their own bucket), and no other org's policy may select it.
///
/// SECRETS. Everything that authenticates lives in `encryptedSecret` as one AES-256-GCM blob
/// (utils/encryption.ts) and is decrypted only inside the adapter that needs it. `config` holds
/// what is safe to show back: a bucket name, a region, a host, a folder id.
model BackupDestination {
  id              String                @id @default(uuid())
  organizationId  String?
  organization    Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String                @db.VarChar(120)
  kind            BackupDestinationKind
  /// Non-secret settings, shape per kind — see services/backup-destination.service.ts.
  config          Json
  encryptedSecret String?               @db.Text
  /// Key prefix every object for this destination is written under, e.g. `timesphere/`.
  prefix          String?               @db.VarChar(255)
  isDefault       Boolean               @default(false)
  /// Result of the last connectivity test. Recorded, never enforced: a bucket unreachable from a
  /// laptop can be perfectly reachable from the API host, so a failing test must not block a save.
  lastTestedAt    DateTime?
  lastTestStatus  String?               @db.VarChar(16)
  lastTestMessage String?               @db.Text
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  runs     BackupRun[]
  policies OrgBackupPolicy[]

  @@index([organizationId])
}

/// One workspace's backup schedule and retention rules. At most one per organization.
model OrgBackupPolicy {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  enabled   Boolean         @default(false)
  /// Requested cadence. The scheduler clamps it to the tier's `backupFrequency` on every tick, so
  /// a downgrade takes effect without anyone editing the policy.
  frequency BackupFrequency @default(NONE)
  /// UTC hour for a daily/weekly run. Stored in UTC and labelled as UTC everywhere, because a
  /// platform serving several timezones cannot mean "2am" without saying whose.
  hourUtc   Int             @default(2)
  /// 0 = Sunday. Only read for WEEKLY.
  dayOfWeek Int             @default(0)

  destinationId String?
  destination   BackupDestination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  retentionMode BackupRetentionMode @default(COUNT)
  keepCount     Int                 @default(7)
  keepDays      Int                 @default(30)
  gfsDaily      Int                 @default(7)
  gfsWeekly     Int                 @default(4)
  gfsMonthly    Int                 @default(12)
  gfsYearly     Int                 @default(3)

  /// Comma-separated addresses. Empty means nobody is mailed — which the console says out loud,
  /// because a backup nobody is told about failing is the same as no backup.
  alertEmails           String? @db.VarChar(1000)
  /// A Slack incoming webhook or any HTTPS endpoint. Encrypted: the URL IS the credential.
  encryptedAlertWebhook String? @db.Text
  alertOnSuccess        Boolean @default(false)
  alertOnFailure        Boolean @default(true)

  lastRunAt  DateTime?
  lastStatus BackupRunStatus?
  /// When the scheduler will next consider this policy. Recomputed after every run, so a tick that
  /// runs twice does nothing the second time.
  nextRunAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, nextRunAt])
}

/// One backup attempt — scheduled, manual, pre-delete, or a test restore. The monitoring screen,
/// the alerts and the retention sweep all read this table.
model BackupRun {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  destinationId  String?
  destination    BackupDestination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  kind           BackupRunKind
  status         BackupRunStatus
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?
  /// Size of the dump. Null while RUNNING and on a failure before anything was written.
  bytes          BigInt?
  /// Where it landed, in the destination's own address space.
  objectKey      String?         @db.VarChar(1024)
  /// SHA-256 of the dump, so a restore can prove it read back what was written.
  checksumSha256 String?         @db.Char(64)
  errorMessage   String?         @db.Text
  /// Which GFS slot keeps this run alive: DAILY / WEEKLY / MONTHLY / YEARLY, or null under the
  /// simpler retention modes.
  retentionTag   String?         @db.VarChar(16)
  metadata       Json?

  @@index([organizationId, startedAt])
  @@index([status, startedAt])
  @@index([destinationId])
}

/// One platform-wide maintenance broadcast — armed or cleared across N workspaces at once.
///
/// The WINDOW itself is not stored here: it lives in each workspace's own `MaintenanceSettings`,
/// which is what the request gate, the SPA redirect and the heartbeat already read. Duplicating it
/// in the control plane would create two sources of truth that can disagree, and "the platform says
/// maintenance, the workspace says no" is a state nobody can debug.
///
/// What IS stored is the thing a tenant row cannot answer: did this reach all forty of them, who
/// sent it, and which ones failed.
model PlatformMaintenanceBroadcast {
  id               String    @id @default(uuid())
  enabled          Boolean
  scheduledStartAt DateTime?
  scheduledEndAt   DateTime?
  message          String?   @db.VarChar(500)
  /// The platform admin's email. Not a user id: they have no user row in any tenant.
  actorLabel       String    @db.VarChar(255)
  targetCount      Int
  appliedCount     Int
  failedCount      Int
  notifiedCount    Int       @default(0)
  emailedCount     Int       @default(0)
  /// Per-workspace results, so a partial failure names the workspaces rather than a count.
  outcomes         Json?
  createdAt        DateTime  @default(now())

  @@index([createdAt])
}

/// One hourly reading of one workspace's database, kept so the console can draw a TREND rather
/// than a number. A single measurement answers "how big is it"; a series answers the questions an
/// operator actually has — "is it growing", "when does it cross the plan's ceiling", "did that
/// index we added on Tuesday change anything".
///
/// WHY THE SIZES ARE Float AND NOT BigInt: Prisma maps BigInt to a JS BigInt, which `JSON.stringify`
/// throws on — so every route returning one needs a bespoke serialiser, and the one that forgets
/// fails in production rather than in tests. A double is exact for integers up to 2^53, which is
/// nine petabytes; the precision that buys us nothing costs a whole class of runtime error.
///
/// AGGREGATE ONLY. Sizes, counts and server counters. No table names, no row contents — the same
/// line the rest of the platform console holds.
model TenantDbSample {
  id             String   @id @default(uuid())
  organizationId String
  sampledAt      DateTime @default(now())

  totalBytes    Float
  dataBytes     Float
  indexBytes    Float
  /// Allocated and unused — the space an OPTIMIZE would hand back.
  freeBytes     Float
  tableCount    Int
  estimatedRows Float
  /// How long the metadata query took. A trend here is the earliest warning of a struggling box.
  queryMs       Int

  /// Server-wide at the moment of sampling, so a spike in the size series can be read against
  /// whether the machine was under load when it was taken.
  connectionUsePercent Float?
  bufferPoolHitRate    Float?
  slowQueries          Float?

  /// --- Schema-shape findings (5.0.0) ---------------------------------------------------------
  /// `getDatabaseMetrics` has always computed these two, raised an alert from them and then thrown
  /// them away, so the only question an operator ever actually asks about them — "when did this
  /// start?" — had no answer anywhere. Two counts make the trend; the names make it actionable.
  ///
  /// NULLABLE, AND NULL IS NOT ZERO. Every sample taken before this column existed genuinely does
  /// not know, and a backfilled 0 would read as "we checked that hour and the schema was clean",
  /// which is precisely the false history the chart is being built to avoid.
  tablesWithoutPrimaryKey Int?
  indexHeavyTables        Int?
  /// The names behind those two counts, `{ "tablesWithoutPrimaryKey": [...], "indexHeavyTables": [...] }`,
  /// capped so one pathological schema cannot make an hourly row enormous. Table NAMES only —
  /// still aggregate, still nothing about what any row says, the same line every other
  /// cross-tenant column in this schema holds.
  schemaFindings          Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, sampledAt])
  @@index([sampledAt])
}

/// One row per workspace per day: what the business looked like that day.
///
/// WHY THIS EXISTS (5.0.0). `platform-admin-analytics.service.ts` opened a connection to EVERY
/// tenant database on EVERY page load and returned a live snapshot with no history. Two faults in
/// one design: it got slower with every customer won, and because nothing was ever kept, no trend,
/// cohort, churn or retention question could be asked AT ALL. Not "was hard to answer" — could not
/// be asked, because the data to answer it was never written down. A nightly worker writes this
/// table and the console reads it, so the fleet loop happens once a night instead of once a click.
///
/// THERE IS NO BACKFILL AND THERE CANNOT BE ONE. Every figure below is a point-in-time count of
/// mutable tenant state; yesterday's is simply gone. The series therefore starts on the day this
/// ships, and every reader must survive a one-row history without dividing by zero or rendering a
/// confident percentage off two points.
///
/// STILL AGGREGATE-ONLY, and that is not negotiable. Counts, sums and timestamps. No ticket title,
/// no comment, no person, no email address — the same guarantee `platform-admin-analytics.service`
/// exists to uphold, now written down once a night instead of read once a click. A future need for
/// row-level tenant content does not belong in this table.
model OrgUsageSnapshot {
  id             String   @id @default(uuid())
  organizationId String
  /// Midnight UTC of the day this row describes. The unique key with `organizationId`, so a
  /// re-run of the nightly sweep UPDATES the day instead of appending a second row — which is what
  /// stops a retried pass double-counting every workspace into the fleet totals.
  day            DateTime
  /// When the reading was actually taken, which is not `day` on a re-run or a manual sweep.
  capturedAt     DateTime @default(now())

  /// Active, non-agent users — the same predicate `countActiveSeats()` uses, because this is the
  /// number that gets BILLED. Agents are a real `User` row so assignment and audit keep working;
  /// charging for them would make the roster a per-agent upsell by accident.
  activeSeats Int
  /// Automation identities, counted SEPARATELY rather than folded in. Adoption of the agent roster
  /// is worth seeing, and keeping the two columns apart is what makes "MRR never bills a robot" a
  /// property a test can break rather than a comment nobody re-reads.
  agentSeats  Int  @default(0)
  /// The ceiling in force that day — the org's override, else the tier's. Kept per-row because the
  /// tier's limit is editable, and a seat-pressure chart drawn against TODAY's ceiling would
  /// silently rewrite history the moment somebody retunes a plan.
  seatLimit   Int

  /// Tickets by status, as `{ "OPEN": 12, … }`. JSON rather than a column per status because the
  /// status vocabulary is admin-extensible (see the tenant schema's custom workflows) and a column
  /// per status would need a migration every time a customer invents one.
  ticketCountsByStatus Json
  /// The same map summed, denormalised so "total work in the fleet" is one aggregate rather than a
  /// JSON walk over every row in the window.
  ticketsTotal         Int
  /// OPEN + IN_PROGRESS + IN_REVIEW + REOPENED — the backlog, which is the half that trends.
  ticketsOpen          Int

  /// Month-to-date at the moment of capture, in USD. Month-to-date rather than same-day because
  /// that is the figure the AI budget ceiling is enforced against, so the two are comparable.
  aiSpendMonthToDateUsd Decimal @db.Decimal(12, 4)
  /// The ceiling that spend is measured against, same reasoning as `seatLimit`.
  aiBudgetCeilingUsd    Decimal @db.Decimal(10, 2)

  /// Outbound tenant mail, month-to-date, counts only. Never a recipient, subject or body.
  emailsSentMonthToDate   Int
  emailsFailedMonthToDate Int

  /// Total size of the workspace's database, if a `TenantDbSample` was taken recently. Read from
  /// THIS database rather than by opening the tenant's — the hourly sampler already paid that cost,
  /// and there is no reason to pay it twice. Null when the sampler has not reached the org yet.
  databaseBytes Float?

  /// The most recent sign-in in the workspace. The one field that answers "have they gone quiet",
  /// which is the leading indicator of every churn conversation.
  lastActivityAt DateTime?

  /// The commercial state AS IT STOOD THAT DAY. All VARCHAR rather than the `PlanTier`/`OrgStatus`
  /// enums above, deliberately: this is a historical record, and an enum value that is later
  /// renamed or retired would either rewrite the past or make old rows unreadable. The migration
  /// rule this schema follows for the same reason — enum-shaped columns are VARCHAR, because
  /// renaming a MySQL ENUM is a table rewrite.
  planTier             String    @db.VarChar(24)
  status               String    @db.VarChar(24)
  trialStartedAt       DateTime?
  trialEndsAt          DateTime?
  trialTier            String?   @db.VarChar(24)
  /// Whether a Stripe subscription existed that day. The lifecycle signal that separates "paid" from
  /// "on a tier somebody set by hand", which are the same `planTier` and very different businesses.
  stripeSubscriptionId String?   @db.VarChar(255)

  /// False when the tenant database could not be read. The row is still written, with the control
  /// plane's own facts (plan, status, trial clock) intact and the tenant counts left null-ish — a
  /// gap in a chart is honest, and a false zero looks like a customer who stopped working.
  reachable Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, day])
  @@index([day])
}

/// The platform operator's OWN model configuration, entirely separate from any workspace's.
///
/// WHY SEPARATE. A workspace's AI settings are its own: its key, its budget, its data-residency
/// choice. Borrowing one to reason about the fleet would spend a customer's money on somebody
/// else's problem and put one tenant's operational detail through another tenant's provider. This
/// row is the platform's own key, used only for the platform's own screens.
///
/// The advisor is OFF until an operator configures it. There is no default provider, no fallback to
/// a tenant's settings, and nothing is sent anywhere while `enabled` is false.
model PlatformAiSettings {
  id       String  @id @default("global")
  enabled  Boolean @default(false)
  /// "ANTHROPIC" or "OPENAI_COMPATIBLE" — the same two shapes the tenant side supports, so a
  /// self-hosted Ollama is a first-class choice for an operator who will not send fleet metrics to
  /// a third party at all.
  provider String  @default("ANTHROPIC") @db.VarChar(32)
  /// Required for OPENAI_COMPATIBLE; ignored for Anthropic.
  baseUrl  String? @db.VarChar(500)
  model    String  @default("claude-sonnet-5") @db.VarChar(120)
  /// AES-256-GCM, write-only. The console is told whether a key is set, never what it is.
  encryptedApiKey String? @db.Text

  /// A hard ceiling on generations per UTC day across the whole console. An advisor that can be
  /// re-run in a loop is a bill with a UI.
  dailyCallLimit Int @default(50)

  updatedAt   DateTime @updatedAt
  updatedBy   String?  @db.VarChar(255)
}

/// One generated advisory, kept whether or not anybody acted on it.
///
/// KEPT ON PURPOSE, all of them. The value of an advisor is not the sentence it produced today, it
/// is whether its sentences were right — which is only answerable if the wrong ones are still there
/// next to the right ones. Dismissals are as interesting as applications.
///
/// NOTHING HERE EXECUTES. A finding names an action from a closed allowlist; running it is a
/// separate, human-initiated call to the same guarded endpoint the operator could have used
/// directly. The model proposes; a person disposes.
model PlatformAiAdvice {
  id             String   @id @default(uuid())
  organizationId String
  createdAt      DateTime @default(now())
  /// Who asked for it. The advisor is never self-triggered.
  actorLabel     String   @db.VarChar(255)
  model          String   @db.VarChar(120)
  /// One-paragraph summary, already length-clamped by the sanitiser.
  summary        String   @db.Text
  /// The validated findings: severity, title, why, and an allowlisted action id.
  findings       Json?
  /// What the model was shown, so a wrong answer can be diagnosed rather than argued about.
  factsDigest    Json?
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  /// "PENDING" until a human acts: "APPLIED", "DISMISSED".
  status         String   @default("PENDING") @db.VarChar(24)
  decidedAt      DateTime?
  decidedBy      String?  @db.VarChar(255)
  /// Free text from the operator when they dismissed it — the training signal that matters most.
  decisionNote   String?  @db.Text

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([createdAt])
}

/// How the fleet's alerts LEAVE the console (5.0.0), id = "global".
///
/// WHY THIS EXISTS. `platform-tenant-health.service.ts#deriveAlerts` has computed real, severity-
/// tiered fleet alerts since 4.0.0, and every one of them only existed if an operator remembered to
/// open the Monitoring page. A monitoring system nobody is looking at is a log file with charts.
/// This row is the operator's answer to "where should these go, and how loud".
///
/// SAME "DATABASE ROW, ELSE NOTHING" SHAPE as PlatformMailSettings and PlatformAiSettings, with one
/// difference: there is no env fallback, deliberately. An alert destination is a deployment
/// decision somebody must make on purpose; inventing one from an environment variable would send a
/// customer's workspace name somewhere nobody chose.
model PlatformAlertSettings {
  id String @id

  /// The scheduled email. On by default — the whole point is that it does not need switching on
  /// before it can help — but it sends nothing until something is actually wrong.
  digestEnabled Boolean @default(true)
  /// The floor a change has to clear to be worth a message: "critical", "warning" or "info".
  /// VARCHAR rather than an enum for the reason every enum-shaped column in this schema is.
  minSeverity   String  @default("warning") @db.VarChar(16)
  /// Explicit recipients, as a JSON array of addresses. Null or empty means "every ACTIVE platform
  /// admin", which is the right default and the one that survives somebody leaving.
  recipients    Json?

  /// The optional outbound webhook — a Slack incoming webhook, a PagerDuty Events URL, anything
  /// that takes a POST. Null means NOT CONFIGURED, which is a first-class state everywhere that
  /// reads it: the console says so, the digest skips it silently, and nothing pretends to have
  /// delivered anywhere.
  webhookUrl             String? @db.VarChar(500)
  /// AES-256-GCM (utils/encryption.ts). Optional: when set, every delivery carries
  /// `X-TimeSphere-Signature: sha256=<hex>` over the raw body, the same scheme
  /// `webhook-dispatch.service.ts` signs tenant webhooks with, so a receiver can verify us.
  encryptedWebhookSecret String? @db.Text

  /// Observability for the thing that provides observability. `lastRunAt` moves on every sweep and
  /// `lastSentAt` only when a message actually went out, so "quiet because nothing changed" and
  /// "quiet because the worker is dead" are distinguishable from the console.
  lastRunAt         DateTime?
  lastSentAt        DateTime?
  lastWebhookAt     DateTime?
  lastWebhookStatus String?   @db.VarChar(64)

  updatedAt DateTime @updatedAt
  updatedBy String?  @db.VarChar(255)
}

/// What has already been reported, per workspace per condition. This table IS the anti-noise rule.
///
/// THE PROBLEM IT SOLVES. A digest that arrives every morning saying the same three things is a
/// digest people filter into a folder, and the morning it says a fourth thing nobody reads it
/// either. So the worker reports CHANGES — a condition that is new, one whose severity has gone up,
/// one that has cleared — and a standing alert that is exactly as it was yesterday is recorded here
/// and NOT re-sent.
///
/// `alertKey` IS THE IDENTITY OF THE CONDITION, NOT OF THE MESSAGE. "Database connections at 84%"
/// and "…at 87%" are the same condition with different words, so the key is derived from the alert's
/// area and its stable shape and never from the number in its title — otherwise every percentage
/// tick would look like a brand-new alert and the noise this table prevents would come back through
/// the front door.
///
/// `reportedSeverity` IS SEPARATE FROM `severity` ON PURPOSE, and it is what makes a failed delivery
/// self-healing. `severity` is what the last sweep saw; `reportedSeverity` is what somebody was
/// actually told, and it is only written when a channel accepted the message. A relay that was down
/// therefore leaves the alert looking new on the next run instead of being silently swallowed.
///
/// ROWS ARE RESOLVED, NEVER DELETED (until the workspace is): `firstSeenAt` on a row that has been
/// through three cycles is the answer to "when did this start", which is the question the org
/// profile's incident timeline is built to answer.
model PlatformAlertState {
  id             String @id @default(uuid())
  organizationId String
  alertKey       String @db.VarChar(191)

  /// What the most recent sweep saw.
  severity String @db.VarChar(16)
  title    String @db.VarChar(255)
  detail   String @db.Text
  area     String @db.VarChar(24)

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime
  /// When a message about this condition was last DELIVERED, and at what severity. Both null until
  /// one actually leaves the building.
  lastReportedAt   DateTime?
  reportedSeverity String?   @db.VarChar(16)
  /// Set on the first sweep the condition is gone. A later recurrence clears it again rather than
  /// creating a second row, so the timeline reads as one condition coming and going.
  resolvedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, alertKey])
  @@index([resolvedAt, severity])
  @@index([organizationId, lastSeenAt])
}
