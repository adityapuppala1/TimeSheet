generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  MANAGER
  TEAM_LEAD
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

enum TicketSource {
  MANUAL
  EMAIL
  API
  CHAT
}

enum ChatPlatform {
  SLACK
  MICROSOFT_TEAMS
  GOOGLE_CHAT
  TELEGRAM
}

enum ChatMatchType {
  CHANNEL_ID
  COMMAND_PREFIX
}

enum EmailMatchType {
  TO_ADDRESS
  TO_PLUS_TAG
  SUBJECT_PREFIX
}

enum TicketLinkType {
  BLOCKS
  DUPLICATE
  RELATES
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  IN_REVIEW
  RESOLVED
  CLOSED
  REOPENED
}

model Role {
  id          String           @id @default(uuid())
  name        RoleName         @unique
  description String?
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                       String     @id @default(uuid())
  name                     String
  email                    String     @unique
  passwordHash             String
  status                   UserStatus @default(PENDING_VERIFICATION)
  roleId                   String
  role                     Role       @relation(fields: [roleId], references: [id])
  avatarUrl                String?    @db.VarChar(500)
  bio                      String?    @db.Text
  phoneNumber              String?    @db.VarChar(40)
  timezone                 String?    @db.VarChar(80)
  /// Free-text job title (e.g. "Senior Backend Engineer") — distinct from `role` (the RBAC
  /// role: SUPER_ADMIN/ADMIN/MANAGER/TEAM_LEAD/EMPLOYEE, which governs permissions). A person's
  /// designation has no bearing on what they can do in the app; it's display-only context shown
  /// alongside their name (Users table, org chart) so "who does what" reads clearly even when
  /// several people share the same RBAC role.
  designation              String?    @db.VarChar(120)
  /// GitHub login (no leading @), admin-set — lets the security-ingestion pipeline resolve a
  /// finding's CODEOWNERS entry or last-committer to a real TimeSphere user for auto-assignment
  /// (security-report.service.ts#maybeAssignFindingViaCodeowners). Optional and unrelated to
  /// GitConnection (that's the org's OAuth App credential; this is one person's identity on
  /// whatever repo the org connected). No uniqueness constraint — nothing in this app requires
  /// one GitHub login map to exactly one user, though in practice it always will.
  githubUsername           String?    @db.VarChar(120)
  /// The IdP's own opaque id for this user (SCIM's `externalId`), set only for users provisioned
  /// via SCIM (scim.controller.ts). Unique so a single IdP push always maps to exactly one row;
  /// null for every manually-created/SSO-first-login user, which is fine — MySQL unique indexes
  /// allow any number of NULLs.
  scimExternalId           String?    @unique @db.VarChar(255)
  emailVerifiedAt          DateTime?
  lastLoginAt              DateTime?
  /// Admin-only, opt-in. Only read when GlobalTicketSettings.enableCostAnalytics is on.
  hourlyRate               Decimal?   @db.Decimal(10, 2)
  /// Admin-set per-user override for face (identity) verification, in the same
  /// "global switch + per-user opt-in" shape as `hourlyRate`/`enableCostAnalytics`: only read
  /// when GlobalFaceVerificationSettings.enabled is on, and only consulted when that row's
  /// enforcementMode is SELECTED (in ALL mode every non-exempt user is covered regardless).
  /// Defaults false so enabling the workspace switch never silently starts demanding a webcam
  /// from an entire company at once.
  faceVerificationRequired Boolean    @default(false)

  managerId String?
  manager   User?   @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[]  @relation("UserManager")

  sessions               Session[]
  resetTokens            PasswordResetToken[]
  projectAssignments     UserProjectAssignment[]
  timesheets             Timesheet[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  escalationsFrom        Escalation[]            @relation("EscalationFrom")
  escalationsTo          Escalation[]            @relation("EscalationTo")
  notificationPreference NotificationPreference?

  reportedTickets           Ticket[]                  @relation("TicketReporter")
  assignedTickets           Ticket[]                  @relation("TicketAssignee")
  ticketComments            TicketComment[]
  ticketWatches             TicketWatcher[]
  uploadedTicketAttachments TicketAttachment[]
  ticketEscalationsFrom     TicketEscalation[]        @relation("TicketEscalationFrom")
  ticketEscalationsTo       TicketEscalation[]        @relation("TicketEscalationTo")
  moduleAssigneeRules       ModuleAssigneeRule[]
  aiUsageLogs               AIUsageLog[]
  ticketBranchesAdded       TicketBranch[]
  apiKeysCreated            ApiKey[]
  outboundWebhooksCreated   OutboundWebhook[]
  gitConnectionsMade        GitConnection[]
  ticketRuleAssignments     TicketRule[]              @relation("TicketRuleAssignee")
  ticketRuleNotifications   TicketRule[]              @relation("TicketRuleNotify")
  faceEnrollment            FaceEnrollment?
  faceVerifications         FaceVerificationAttempt[] @relation("FaceVerificationSubject")
  faceVerificationsReviewed FaceVerificationAttempt[] @relation("FaceVerificationReviewer")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([roleId, status])
  @@index([managerId])
}

model Session {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash         String
  /// The immediately-prior refresh secret's hash, kept valid for a short grace window after
  /// rotation (see auth.service.ts#refresh) so that two concurrent requests on the same
  /// still-legitimate session (two tabs, a retried request, a test harness replaying a
  /// snapshot) don't each look like token theft just because they raced a rotation.
  previousRefreshHash String?
  refreshRotatedAt    DateTime?
  userAgent           String?
  ipAddress           String?
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Project {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  status      String  @default("ACTIVE")

  /// Hours allowed between SUBMITTED and APPROVED before SLA breach + escalation.
  slaApprovalHours             Int  @default(48)
  /// Day of month by which employees must have submitted (1-28). Null = no cadence enforcement.
  submissionDeadlineDayOfMonth Int?

  /// Last issued ticket sequence number for this project's human-readable key (e.g. `${code}-${ticketSeq}`).
  /// Incremented transactionally on ticket creation to avoid collisions.
  ticketSeq Int @default(0)

  modules                   ProjectModule[]
  assignments               UserProjectAssignment[]
  timesheets                Timesheet[]
  tickets                   Ticket[]
  emailRoutingRules         EmailRoutingRule[]
  emailIntakeFallbackFor    EmailIntakeSettings[]
  chatRoutingRules          ChatRoutingRule[]
  chatIntegrationDefaultFor ChatIntegration[]
  ingestionFallbackFor      IngestionSettings[]
  ticketRules               TicketRule[]
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  deletedAt                 DateTime?
}

model ProjectModule {
  id                String              @id @default(uuid())
  projectId         String
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name              String
  status            String              @default("ACTIVE")
  submodules        ProjectSubmodule[]
  timesheets        Timesheet[]
  tickets           Ticket[]
  emailRoutingRules EmailRoutingRule[]
  chatRoutingRules  ChatRoutingRule[]
  assigneeRule      ModuleAssigneeRule?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([projectId, name])
}

model ProjectSubmodule {
  id         String        @id @default(uuid())
  moduleId   String
  module     ProjectModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name       String
  status     String        @default("ACTIVE")
  timesheets Timesheet[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([moduleId, name])
}

model UserProjectAssignment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
}

model ActivityType {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Timesheet {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id])
  moduleId        String
  module          ProjectModule     @relation(fields: [moduleId], references: [id])
  submoduleId     String?
  submodule       ProjectSubmodule? @relation(fields: [submoduleId], references: [id])
  ticketId        String?
  ticket          Ticket?           @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  activityType    String
  taskDescription String            @db.Text
  workDate        DateTime          @db.Date
  startTime       String
  endTime         String
  totalHours      Decimal           @db.Decimal(5, 2)
  notes           String?           @db.Text
  status          TimesheetStatus   @default(DRAFT)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?

  /// When approval is due. Computed from project.slaApprovalHours at submit time.
  approvalDeadline DateTime?
  /// First time we detected the approval SLA was missed.
  slaBreachAt      DateTime?
  /// When the approval was escalated up the hierarchy.
  escalatedAt      DateTime?

  attachments Attachment[]
  escalations Escalation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, workDate, status])
  @@index([projectId, workDate])
  @@index([status, approvalDeadline])
  @@index([ticketId])
}

model Attachment {
  id          String    @id @default(uuid())
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  fileName    String
  mimeType    String
  url         String
  sizeBytes   Int
  createdAt   DateTime  @default(now())
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String    @db.Text
  /// e.g. timesheet.approved, timesheet.rejected, sla.breach, escalation
  category  String?   @db.VarChar(80)
  /// Optional URL inside the app to deep-link to relevant resource.
  link      String?   @db.VarChar(500)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([actorId, entity, createdAt])
}

model FormConfiguration {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// When approval SLA is breached, an Escalation is created targeting the manager's manager
/// (or an ADMIN fallback). Resolved when the underlying timesheet is approved/rejected.
model Escalation {
  id                String    @id @default(uuid())
  timesheetId       String
  timesheet         Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  escalatedFromId   String
  escalatedFromUser User      @relation("EscalationFrom", fields: [escalatedFromId], references: [id])
  escalatedToId     String
  escalatedToUser   User      @relation("EscalationTo", fields: [escalatedToId], references: [id])
  reason            String    @db.VarChar(500)
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([escalatedToId, resolvedAt])
  @@index([timesheetId])
}

/// Per-user opt-ins for each email channel. In-app notifications are always created.
model NotificationPreference {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailTimesheetApproved  Boolean @default(true)
  emailTimesheetRejected  Boolean @default(true)
  emailTimesheetSubmitted Boolean @default(true)
  emailSlaBreach          Boolean @default(true)
  emailDeadlineReminder   Boolean @default(true)
  emailEscalation         Boolean @default(true)
  emailWeeklyDigest       Boolean @default(false)

  updatedAt DateTime @updatedAt
}

/// Append-only log of every outbound transactional email.
model EmailLog {
  id           String      @id @default(uuid())
  to           String      @db.VarChar(255)
  subject      String      @db.VarChar(255)
  template     String      @db.VarChar(80)
  status       EmailStatus @default(QUEUED)
  errorMessage String?     @db.Text
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([to, createdAt])
  @@index([status, createdAt])
  @@index([template, createdAt])
}

/// Admin-editable email templates. Falls back to the compiled defaults if no row exists.
/// Variable substitution uses {{name}} syntax — variables list is informational for the UI.
model EmailTemplate {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(80)
  subject     String   @db.VarChar(255)
  bodyHtml    String   @db.Text
  description String?  @db.VarChar(500)
  variables   Json
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model Ticket {
  id        String         @id @default(uuid())
  /// Human-readable key, e.g. "WEB-123" — `${project.code}-${seq}`, seq issued via Project.ticketSeq.
  key       String         @unique @db.VarChar(20)
  projectId String
  project   Project        @relation(fields: [projectId], references: [id])
  moduleId  String?
  module    ProjectModule? @relation(fields: [moduleId], references: [id])

  /// Free string validated at the API layer against active TicketType.name rows —
  /// mirrors how Timesheet.activityType relates to ActivityType (no hard FK), so
  /// admins can add/retire types without a schema migration.
  type        String         @default("BUG") @db.VarChar(60)
  title       String         @db.VarChar(255)
  description String?        @db.Text
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  source      TicketSource   @default(MANUAL)

  reporterId String
  reporter   User    @relation("TicketReporter", fields: [reporterId], references: [id])
  assigneeId String?
  assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id])

  /// Real sender when source = EMAIL and they aren't a registered User (reporterId
  /// points at the seeded "Email Intake" system user in that case).
  externalReporterEmail String? @db.VarChar(255)
  externalReporterName  String? @db.VarChar(160)

  /// Same role as the externalReporter* fields above, but for source = CHAT — the reporterId
  /// still points at a seeded system user (see prisma/seed.ts's chat-intake system account),
  /// while these carry who actually sent the message on the originating chat platform.
  externalChatPlatform  ChatPlatform?
  externalChatUserId    String?       @db.VarChar(255)
  externalChatUserName  String?       @db.VarChar(160)
  externalChatChannelId String?       @db.VarChar(255)

  /// Computed from priority at creation time (GlobalTicketSettings), mirrors Timesheet.approvalDeadline.
  dueAt       DateTime?
  slaBreachAt DateTime?
  resolvedAt  DateTime?
  closedAt    DateTime?

  /// Set when an AI classifier (manual suggestion or email intake) produced this ticket's
  /// type/priority/assignee. Null when a human set every field directly.
  aiConfidence     Float?
  /// True when aiConfidence fell below the configured threshold — surfaced to admins/managers
  /// instead of being silently auto-assigned.
  needsReview      Boolean  @default(false)
  estimatedHours   Decimal? @db.Decimal(5, 2)
  /// Admin thumbs-up/down on the AI Activity Log page — "up" | "down", null = no feedback given.
  aiFeedback       String?  @db.VarChar(10)
  /// Set when this ticket was created from (or later matched) an ingested error-tracking event
  /// (Sentry/Rollbar/raw — see devops-webhook.controller.ts's /error-events route). A later
  /// event carrying the SAME fingerprint against a RESOLVED/CLOSED ticket auto-reopens it via
  /// the existing maybeReopenTicketOnRegression, even with no explicit ticketKey in the new
  /// event — "the same crash came back" is detectable without a human re-linking it by hand.
  errorFingerprint String?  @db.VarChar(128)

  comments         TicketComment[]
  attachments      TicketAttachment[]
  watchers         TicketWatcher[]
  escalations      TicketEscalation[]
  timesheets       Timesheet[]
  labels           TicketLabel[]
  aiUsageLogs      AIUsageLog[]
  linksFrom        TicketLink[]          @relation("TicketLinkSource")
  linksTo          TicketLink[]          @relation("TicketLinkTarget")
  checklistItems   TicketChecklistItem[]
  securityFindings SecurityFinding[]
  testRuns         TestRun[]
  branches         TicketBranch[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([status, dueAt])
  @@index([reporterId])
  @@index([errorFingerprint])
}

model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, createdAt])
}

model TicketAttachment {
  id           String   @id @default(uuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  url          String
  sizeBytes    Int
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([ticketId])
}

model TicketWatcher {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ticketId, userId])
}

/// Mirrors Escalation's shape exactly; kept separate because Escalation is hard-FK'd to Timesheet.
model TicketEscalation {
  id                String    @id @default(uuid())
  ticketId          String
  ticket            Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  escalatedFromId   String
  escalatedFromUser User      @relation("TicketEscalationFrom", fields: [escalatedFromId], references: [id])
  escalatedToId     String
  escalatedToUser   User      @relation("TicketEscalationTo", fields: [escalatedToId], references: [id])
  reason            String    @db.VarChar(500)
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([escalatedToId, resolvedAt])
  @@index([ticketId])
}

/// Admin-editable ticket type list (Bug/Task/Improvement by default). Mirrors ActivityType —
/// Ticket.type is a free string validated against active rows here, not a hard FK.
model TicketType {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(60)
  color     String?  @db.VarChar(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Label {
  id          String        @id @default(uuid())
  name        String        @unique @db.VarChar(60)
  color       String?       @db.VarChar(20)
  createdAt   DateTime      @default(now())
  tickets     TicketLabel[]
  ticketRules TicketRule[]
}

model TicketLabel {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  labelId   String
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ticketId, labelId])
}

/// Singleton (id = "global"). Workspace-wide ticket SLA hours (replacing the former
/// TICKET_SLA_*_HOURS env vars, now editable without a server restart) plus opt-in,
/// off-by-default analytics that touch sensitive data (hourly rates, per-person rankings).
model GlobalTicketSettings {
  id                         String   @id
  slaLowHours                Int      @default(168)
  slaMediumHours             Int      @default(72)
  slaHighHours               Int      @default(24)
  slaCriticalHours           Int      @default(4)
  enableCostAnalytics        Boolean  @default(false)
  enableLeaderboard          Boolean  @default(false)
  /// See docs/ROADMAP.md's "Auto testing on branch/PR push" theme. When true, a ticket whose
  /// latest ingested TestRun is FAILED cannot transition to RESOLVED (ticket.controller.ts's
  /// status route enforces this). Default false — orgs that don't ingest test runs yet, or
  /// that want this as a warning rather than a hard gate, are unaffected either way.
  blockResolveOnFailingTests Boolean  @default(false)
  updatedAt                  DateTime @updatedAt
  updatedById                String?
}

/// Singleton (id = "global"). Master + per-feature AI toggles. aiEnabled defaults false —
/// every AI capability stays inert until an admin explicitly opts in (and ANTHROPIC_API_KEY
/// is configured server-side).
model GlobalAISettings {
  id                          String     @id
  aiEnabled                   Boolean    @default(false)
  autoTriageEnabled           Boolean    @default(false)
  /// When true, AI triage suggestions are applied directly on manual ticket creation;
  /// when false, they're surfaced as a one-click "Accept?" suggestion instead.
  autoTriageAutoApply         Boolean    @default(false)
  duplicateDetectionEnabled   Boolean    @default(false)
  writingAssistantEnabled     Boolean    @default(false)
  commentSummaryEnabled       Boolean    @default(false)
  workspaceSearchEnabled      Boolean    @default(false)
  emailIngestionEnabled       Boolean    @default(false)
  chatIngestionEnabled        Boolean    @default(false)
  weeklyDigestEnabled         Boolean    @default(false)
  /// Gates ai.service.ts#classifyCiFailure — an AI-authored root-cause comment posted on a
  /// ticket when a CI test run fails with `failureText` attached (see
  /// devops-webhook.controller.ts's /test-runs route). Separate from `autoReopenEnabled`
  /// (IngestionSettings) which is deterministic and doesn't call AI at all.
  ciFailureTriageEnabled      Boolean    @default(false)
  /// Gates ai.service.ts#summarizePullRequest — an AI-authored summary comment posted on a
  /// ticket when a linked PR opens (controllers/git-webhook.controller.ts's "opened" handler).
  /// Needs the live GitHub connection (GitConnection) AND a repo webhook configured — see
  /// docs/ROADMAP.md's "AI PR-review summaries" item.
  aiPrReviewSummaryEnabled    Boolean    @default(false)
  /// Gates ai.service.ts#classifySecurityFinding — sibling of ciFailureTriageEnabled, scoped to
  /// ingested SecurityFinding rows instead of CI test-run failures. Only CRITICAL/HIGH findings
  /// are triaged (same severity bar IngestionSettings.fallbackProjectId's auto-ticket-creation
  /// uses) to bound AI spend. See docs/ROADMAP.md's "Competitive parity" Phase 3.
  findingTriageEnabled        Boolean    @default(false)
  /// Gates ai.service.ts#generateSecurityWeeklyDigest — an AI-authored org-wide security summary
  /// (open-findings trend, newly-critical items, tickets past SLA) emailed to every ADMIN/
  /// SUPER_ADMIN weekly, generalizing weeklyDigestEnabled's per-user pattern to an admin audience.
  /// See workers/security-weekly-digest.worker.ts.
  securityWeeklyDigestEnabled Boolean    @default(false)
  /// Gates ai.service.ts#generateStatusReport — on-demand "generate a stakeholder update" for
  /// one project, triggered synchronously from the Project page rather than a cron worker.
  /// Reuses generateWeeklyDigest's prompt shape (given numbers only, no invented analysis) but
  /// is project-scoped and callable any time, not per-user and not on a schedule.
  statusReportEnabled         Boolean    @default(false)
  model                       String     @default("claude-haiku-4-5") @db.VarChar(80)
  confidenceThreshold         Float      @default(0.6)
  monthlyBudgetUsd            Decimal?   @db.Decimal(10, 2)
  /// BYOK: which model family to call. ANTHROPIC uses this row's apiKey (falling back to the
  /// server's ANTHROPIC_API_KEY env var when unset) against the native Messages API; every
  /// other supported vendor (OpenAI, Groq, Mistral, DeepSeek, OpenRouter, Gemini, Qwen, Kimi,
  /// Nvidia NIM, Ollama, LM Studio, or any other custom endpoint) goes through
  /// OPENAI_COMPATIBLE's generic adapter using this row's baseUrl.
  provider                    AIProvider @default(ANTHROPIC)
  /// Only meaningful for OPENAI_COMPATIBLE — e.g. https://api.groq.com/openai/v1 or
  /// http://localhost:11434/v1 for a local Ollama install.
  baseUrl                     String?    @db.VarChar(300)
  /// AES-256-GCM ciphertext (see utils/encryption.ts) — never returned to the client; the API
  /// exposes only an `apiKeySet: boolean`, same masking convention as
  /// EmailIntakeSettings.imapPassword.
  apiKey                      String?    @db.Text
  updatedAt                   DateTime   @updatedAt
  updatedById                 String?
}

enum AIProvider {
  ANTHROPIC
  OPENAI_COMPATIBLE
}

/// Append-only log of every AI call, for cost tracking / the monthly budget cap.
model AIUsageLog {
  id              String   @id @default(uuid())
  feature         String   @db.VarChar(60)
  model           String   @db.VarChar(80)
  inputTokens     Int
  outputTokens    Int
  costUsdEstimate Decimal  @db.Decimal(10, 4)
  ticketId        String?
  ticket          Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  /// The user whose action triggered this AI call (nullable: some triggers, like the
  /// scheduled weekly digest worker, have no request-bound user).
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([feature, createdAt])
  @@index([createdAt])
  @@index([model, createdAt])
  @@index([userId])
}

/// Singleton (id = "global") row that controls which notification categories
/// are allowed to dispatch email across the workspace, plus reminder timings
/// and BCC behavior. Only SUPER_ADMIN edits this.
model GlobalNotificationSettings {
  id                        String  @id
  emailTimesheetSubmitted   Boolean @default(true)
  emailTimesheetApproved    Boolean @default(true)
  emailTimesheetRejected    Boolean @default(true)
  emailSlaBreach            Boolean @default(true)
  emailDeadlineReminder     Boolean @default(true)
  emailEscalation           Boolean @default(true)
  emailWeeklyDigest         Boolean @default(false)
  emailDailyReminder        Boolean @default(true)
  emailDailyEscalation      Boolean @default(true)
  emailTicketAssigned       Boolean @default(true)
  emailTicketStatusChanged  Boolean @default(true)
  emailTicketCommented      Boolean @default(true)
  emailTicketSlaBreach      Boolean @default(true)
  emailTicketEscalation     Boolean @default(true)
  emailTicketNeedsReview    Boolean @default(true)
  /// Sends the security/test-status digest (findings + latest TestRun) to whoever closed a
  /// ticket, their manager, and this org's own admins — see services/security-report.service.ts.
  /// Off by default: irrelevant noise for an org that hasn't connected any scan source yet.
  emailTicketClosedDigest   Boolean @default(false)
  /// Sends the AI weekly security digest (see workers/security-weekly-digest.worker.ts) to every
  /// ADMIN/SUPER_ADMIN. Gated alongside GlobalAISettings.securityWeeklyDigestEnabled — the AI
  /// toggle decides whether the worker runs at all, this decides whether email actually sends,
  /// same two-layer gating emailWeeklyDigest/weeklyDigestEnabled already use.
  emailSecurityWeeklyDigest Boolean @default(false)

  /// Hour (0–23, server local time) for the "log today's time" reminder.
  dailyReminderHour        Int     @default(16)
  /// Hour for the next-morning escalation (employee + manager).
  escalationReminderHour   Int     @default(9)
  /// When true (default), reminders only fire Monday–Friday.
  remindOnWeekdaysOnly     Boolean @default(true)
  /// BCC every active SUPER_ADMIN on every outbound email.
  bccSuperAdminOnAllEmails Boolean @default(false)

  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// Singleton (id = "global"). IMAP mailbox connection + polling cadence for the
/// email-to-ticket ingestion pipeline. Master switch is GlobalAISettings.emailIngestionEnabled —
/// this table only holds *how* to connect and where unmatched mail should land.
/// Singleton (id = "global"), same upsert-by-constant-id pattern as GlobalAISettings/
/// EmailIntakeSettings. Outbound SMTP transport configuration — admin-configurable from
/// Workspace Settings → Mail server instead of only via apps/api/.env's SMTP_* vars. A null
/// `host` means "not configured here" and `services/mail.service.ts` falls back to the env
/// vars (so an existing on-prem deployment relying on .env keeps working unconfigured, same
/// fallback relationship GlobalAISettings.apiKey has with ANTHROPIC_API_KEY).
model GlobalMailSettings {
  id          String  @id
  host        String? @db.VarChar(255)
  port        Int     @default(587)
  secure      Boolean @default(false)
  user        String? @db.VarChar(255)
  /// Never returned to the client — GET responses expose only `passwordSet: boolean`. Encrypted
  /// the same way as EmailIntakeSettings.imapPassword (AES-256-GCM via utils/encryption.ts).
  password    String? @db.VarChar(500)
  fromAddress String? @db.VarChar(255)

  updatedAt   DateTime @updatedAt
  updatedById String?
}

model EmailIntakeSettings {
  id                  String    @id
  imapHost            String?   @db.VarChar(255)
  imapPort            Int       @default(993)
  imapSecure          Boolean   @default(true)
  imapUser            String?   @db.VarChar(255)
  /// Never returned to the client — GET responses expose only `imapPasswordSet: boolean`.
  imapPassword        String?   @db.VarChar(500)
  pollIntervalMinutes Int       @default(5)
  fallbackProjectId   String?
  fallbackProject     Project?  @relation(fields: [fallbackProjectId], references: [id], onDelete: SetNull)
  lastPolledAt        DateTime?
  lastPollError       String?   @db.Text
  updatedAt           DateTime  @updatedAt
  updatedById         String?
}

/// Routes an inbound email to a project (+ optional default module) by matching the
/// To-address, a "+tag" on the To-address, or a subject prefix. Evaluated in createdAt order;
/// first active match wins. No match falls back to EmailIntakeSettings.fallbackProjectId.
model EmailRoutingRule {
  id              String         @id @default(uuid())
  matchType       EmailMatchType
  matchValue      String         @db.VarChar(255)
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  defaultModuleId String?
  defaultModule   ProjectModule? @relation(fields: [defaultModuleId], references: [id], onDelete: SetNull)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())

  @@index([isActive])
}

/// Once a module is resolved for an email-sourced ticket (routing rule default or AI
/// classification), auto-assign it to this user — but only when the ticket didn't
/// land in needsReview (see GlobalAISettings.confidenceThreshold).
model ModuleAssigneeRule {
  id                String        @id @default(uuid())
  moduleId          String        @unique
  module            ProjectModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  defaultAssigneeId String
  defaultAssignee   User          @relation(fields: [defaultAssigneeId], references: [id])
  createdAt         DateTime      @default(now())
}

/// General-purpose if/then automation on manually-created tickets — generalizes
/// ModuleAssigneeRule (which is intake-routing-specific, keyed one-to-one on a module) into a
/// broader rule an admin can shape from Workspace Settings → Ticketing → Automation. Email/chat
/// intake keep using their own existing routing (EmailRoutingRule/ChatRoutingRule/
/// ModuleAssigneeRule) — this only evaluates on the manual-creation path
/// (ticket.controller.ts's POST /), since that's the one surface with no routing rule today.
/// Conditions are AND'd (every set field must match; an unset field means "any"); actions are
/// all applied together when a rule matches. Evaluated in `order` ascending, first match wins —
/// same "first match, not merge-all-matches" semantics ModuleAssigneeRule's lookup already uses,
/// so admins reason about rule order the same way in both places.
model TicketRule {
  id       String  @id @default(uuid())
  name     String  @db.VarChar(120)
  isActive Boolean @default(true)
  order    Int     @default(0)

  conditionProjectId    String?
  conditionProject      Project?        @relation(fields: [conditionProjectId], references: [id], onDelete: Cascade)
  conditionPriority     TicketPriority?
  conditionSource       TicketSource?
  /// Case-insensitive suffix match against the reporter's email domain — only ever matches
  /// EMAIL/CHAT-sourced tickets (manual creation has no "sender domain" concept), included
  /// anyway since a rule combining `source: EMAIL` + a domain is a common real pattern.
  conditionSenderDomain String?         @db.VarChar(255)

  actionAssigneeId   String?
  actionAssignee     User?   @relation("TicketRuleAssignee", fields: [actionAssigneeId], references: [id], onDelete: SetNull)
  actionLabelId      String?
  actionLabel        Label?  @relation(fields: [actionLabelId], references: [id], onDelete: SetNull)
  actionNotifyUserId String?
  actionNotifyUser   User?   @relation("TicketRuleNotify", fields: [actionNotifyUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

/// One row per (platform) this org has connected — same "one wide table, nullable
/// per-platform columns" convention as the control plane's OrgSsoConfig, since each platform's
/// credential shape is different (Slack bot token + signing secret; Teams app id + password;
/// Google Chat verification token + outgoing webhook URL; Telegram bot token). Master switch is
/// GlobalAISettings.chatIngestionEnabled — this table only holds per-platform connection info,
/// mirroring EmailIntakeSettings' relationship to emailIngestionEnabled.
model ChatIntegration {
  id        String       @id @default(uuid())
  platform  ChatPlatform @unique
  isEnabled Boolean      @default(false)

  /// Slack (bot token) / Telegram (bot token) — never returned to the client.
  encryptedBotToken         String? @db.Text
  /// Slack request-signing secret, or a simple shared verification token for Google Chat's
  /// HTTP endpoint — same masking convention, exposed only as a boolean "set" flag.
  encryptedSigningSecret    String? @db.Text
  /// Microsoft Teams (Bot Framework) app registration — appId is not secret, appPassword is.
  teamsAppId                String? @db.VarChar(255)
  encryptedTeamsAppPassword String? @db.Text
  /// Google Chat's simplest outbound path — an org-configured "Incoming Webhook" URL for the
  /// target space. Not secret in the encryption-at-rest sense (it's already a bearer-style
  /// unguessable URL Google issues), so stored plain like SAML's idpCertificate.
  googleChatWebhookUrl      String? @db.VarChar(500)

  defaultProjectId String?
  defaultProject   Project? @relation(fields: [defaultProjectId], references: [id], onDelete: SetNull)

  /// Telegram's long-poll cursor — the highest `update_id` already processed, so the next poll
  /// only fetches new messages.
  telegramUpdateOffset Int?

  lastEventAt DateTime?
  lastError   String?   @db.Text
  updatedAt   DateTime  @updatedAt
  updatedById String?
}

/// Routes an inbound chat message to a project (+ optional default module) — same shape and
/// evaluation order (createdAt, first active match wins) as EmailRoutingRule. CHANNEL_ID matches
/// the platform's own channel/space identifier; COMMAND_PREFIX matches a leading "/ticket ..."
/// style command in the message text.
model ChatRoutingRule {
  id              String         @id @default(uuid())
  platform        ChatPlatform
  matchType       ChatMatchType
  matchValue      String         @db.VarChar(255)
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  defaultModuleId String?
  defaultModule   ProjectModule? @relation(fields: [defaultModuleId], references: [id], onDelete: SetNull)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())

  @@index([platform, isActive])
}

/// Directed relationship between two tickets (e.g. WEB-12 BLOCKS WEB-15). Surfaced as a
/// small "linked tickets" row in the detail sheet, shown from both sides of the relation.
model TicketLink {
  id             String         @id @default(uuid())
  sourceTicketId String
  sourceTicket   Ticket         @relation("TicketLinkSource", fields: [sourceTicketId], references: [id], onDelete: Cascade)
  targetTicketId String
  targetTicket   Ticket         @relation("TicketLinkTarget", fields: [targetTicketId], references: [id], onDelete: Cascade)
  type           TicketLinkType
  createdAt      DateTime       @default(now())

  @@unique([sourceTicketId, targetTicketId, type])
  @@index([targetTicketId])
}

enum TicketBranchPrStatus {
  NONE
  OPEN
  MERGED
  CLOSED
}

/// Manual git repo/branch/PR linking — "which branch/PR is fixing this ticket", entered
/// directly by whoever's working the ticket, not synced live from GitHub/GitLab/etc. See
/// docs/ROADMAP.md's "Git repo & branch mapping" theme: a live git-provider App integration
/// (OAuth, webhook-driven auto-sync) is a genuinely separate, larger scope of work than this —
/// this is the data-model/manual-tracking slice of that theme, not the automated one. A
/// SecurityFinding/TestRun row can reference the same repository/branch as free text (see those
/// models) without a formal relation to this table, since ingestion is tool-agnostic and can't
/// guarantee its branch name matches what a human typed here.
model TicketBranch {
  id         String               @id @default(uuid())
  ticketId   String
  ticket     Ticket               @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  repository String               @db.VarChar(255)
  branch     String               @db.VarChar(255)
  prUrl      String?              @db.VarChar(500)
  prStatus   TicketBranchPrStatus @default(NONE)
  addedById  String?
  addedBy    User?                @relation(fields: [addedById], references: [id], onDelete: SetNull)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([ticketId])
}

/// Simple ordered sub-task list on a ticket. `position` is a dense 0-based index,
/// renumbered on every reorder so drag-and-drop / up-down moves stay consistent.
model TicketChecklistItem {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  label     String   @db.VarChar(255)
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, position])
}

/// Ingest-only, tool-agnostic (see docs/ROADMAP.md's "Security assessment suite" section) —
/// TimeSphere never runs a scanner itself, it stores what external CI/security tools POST to
/// controllers/devops-webhook.controller.ts. SAST/DAST/SSAT(secrets)/SSCT(supply-chain) findings
/// all land here as one table (not one per type) because the per-ticket report and the
/// ticket-close digest email both need to render every type side by side. VAPT is the one
/// exception to "ingested via the CI webhook" — it's a periodic, human-led assessment, not a
/// per-push automated scan, so it arrives via a structured-JSON upload in Workspace Settings
/// instead (see settings.controller.ts's POST /security-ingestion/vapt-report) — but lands in
/// this same table so the per-ticket report/digest render it identically to the other 4 types.
enum SecurityFindingType {
  SAST
  DAST
  SSAT
  SSCT
  VAPT
}

enum SecurityFindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SecurityFindingStatus {
  OPEN
  ACKNOWLEDGED
  FIXED
  ACCEPTED_RISK
}

/// AI's exploitability verdict on a finding — see ai.service.ts#classifySecurityFinding.
/// TRUE_POSITIVE/FALSE_POSITIVE mirror how Fortify Remediation Aviator classifies SAST results;
/// NEEDS_REVIEW is the same "AI wasn't confident enough" outcome auto-triage/duplicate-detection
/// already use elsewhere in this app rather than forcing a guess.
enum SecurityFindingAiVerdict {
  TRUE_POSITIVE
  FALSE_POSITIVE
  NEEDS_REVIEW
}

model SecurityFinding {
  id       String  @id @default(uuid())
  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  type        SecurityFindingType
  /// Free text, e.g. "semgrep", "gitleaks", "syft" — deliberately not an enum since the whole
  /// point of ingest-only is supporting whatever scanner an org already runs.
  tool        String                  @db.VarChar(80)
  severity    SecurityFindingSeverity
  status      SecurityFindingStatus   @default(OPEN)
  title       String                  @db.VarChar(255)
  description String?                 @db.Text
  cwe         String?                 @db.VarChar(40)
  filePath    String?                 @db.VarChar(500)
  lineNumber  Int?

  /// Free text — no live git-provider integration yet (see roadmap's "Git repo & branch
  /// mapping" theme, a separate later phase), so a webhook payload just carries these as
  /// strings rather than resolving them against a Repository/PullRequest table.
  repository String? @db.VarChar(255)
  branch     String? @db.VarChar(255)
  prUrl      String? @db.VarChar(500)

  /// Opt-in AI exploitability triage (GlobalAISettings.findingTriageEnabled) — see
  /// ai.service.ts#classifySecurityFinding. Null until triaged (or if the toggle is off/the
  /// finding's severity didn't qualify — only CRITICAL/HIGH are triaged, same bar
  /// maybeAutoCreateTicketForFinding uses, to bound AI spend to what actually matters).
  aiVerdict        SecurityFindingAiVerdict?
  aiExploitability String?                   @db.Text
  aiFixSuggestion  String?                   @db.Text
  aiTriagedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([type, severity, status])
}

enum TestRunStatus {
  PASSED
  FAILED
  RUNNING
}

/// CI test-run results, same ingest-only model as SecurityFinding — see that model's header
/// comment. A ticket's latest TestRun (by createdAt) is what ticket.controller.ts's status
/// route consults before allowing a RESOLVED transition (see docs/ROADMAP.md theme #2).
model TestRun {
  id       String  @id @default(uuid())
  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  /// Free text, e.g. "github-actions", "gitlab-ci" — same "any tool can POST here" reasoning
  /// as SecurityFinding.tool.
  provider   String        @db.VarChar(80)
  branch     String?       @db.VarChar(255)
  prUrl      String?       @db.VarChar(500)
  status     TestRunStatus
  passCount  Int?
  failCount  Int?
  durationMs Int?
  logUrl     String?       @db.VarChar(500)

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// A single component row from an ingested SBOM (SPDX or CycloneDX) — see
/// devops-webhook.controller.ts's /sbom route. Deliberately not attempting Black Duck's full
/// license-obligation-text depth (see docs/ROADMAP.md's "Competitive parity" Phase 3) — this is
/// a basic "dependency inventory + known-CVE cross-reference" view, not a compliance tool.
model SbomComponent {
  id         String  @id @default(uuid())
  /// Free text, same reasoning as SecurityFinding.repository — no live Repository table yet.
  repository String? @db.VarChar(255)
  name       String  @db.VarChar(255)
  version    String  @db.VarChar(80)
  /// e.g. "npm", "pypi", "maven", "cargo" — free text, whatever the SBOM tool reports.
  ecosystem  String? @db.VarChar(80)
  license    String? @db.VarChar(120)
  /// Populated only if the ingesting tool flagged this component against a known CVE — this app
  /// doesn't itself cross-reference a vulnerability database, it trusts what the SBOM says.
  knownCve   String? @db.VarChar(40)
  format     String  @db.VarChar(20)

  createdAt DateTime @default(now())

  @@index([repository])
  @@index([name])
}

/// Singleton (id = "global"), same upsert-by-constant-id pattern as GlobalAISettings/
/// EmailIntakeSettings. Holds the bearer token controllers/devops-webhook.controller.ts checks
/// before accepting a POST to /api/devops/:orgSlug/* — null encryptedToken means ingestion has
/// never been enabled for this org, so the webhook 404s rather than accepting unauthenticated
/// writes. Encrypted the same way as EmailIntakeSettings.imapPassword (AES-256-GCM via
/// utils/encryption.ts) — see that model's controller for the encrypt-on-save/mask-in-response/
/// decrypt-on-use pattern this copies.
model IngestionSettings {
  id                      String   @id
  encryptedToken          String?
  /// Where a CRITICAL/HIGH finding with no explicit ticketKey auto-creates a ticket (see
  /// devops-webhook.controller.ts). Null = auto-ticket-creation is off; the finding is still
  /// stored, just not turned into a ticket.
  fallbackProjectId       String?
  fallbackProject         Project? @relation(fields: [fallbackProjectId], references: [id], onDelete: SetNull)
  /// When a FAILED TestRun references (via ticketKey) a RESOLVED/CLOSED ticket, automatically
  /// transition it back to REOPENED — see devops-webhook.controller.ts's /test-runs route.
  /// Deterministic (matches on the CI-supplied ticketKey directly), not an AI decision — unlike
  /// GlobalAISettings.ciFailureTriageEnabled, this needs no AI budget/provider configured.
  /// Off by default: silently reopening a ticket is exactly the kind of automated state change
  /// that should be an explicit admin opt-in, not a surprise.
  autoReopenEnabled       Boolean  @default(false)
  /// Opt-in fallback assignment for an auto-created security ticket (see fallbackProjectId above)
  /// when no ModuleAssigneeRule matches: resolve an assignee via the finding's repo CODEOWNERS
  /// entry, or failing that the last GitHub committer on that file — see
  /// security-report.service.ts#maybeAssignFindingViaCodeowners. Off by default: it makes a live
  /// GitHub API call per unmatched finding (needs a connected GitConnection to do anything) and
  /// needs at least one User.githubUsername populated to ever actually resolve someone, so it's
  /// a no-op cost until an admin has both configured — not worth defaulting on.
  codeownersAssignEnabled Boolean  @default(false)

  updatedAt DateTime @updatedAt
}

/// Inbound SCIM 2.0 provisioning (see docs/ROADMAP.md's "Integrations" theme and
/// scim.controller.ts). Same singleton-plus-bearer-token model as IngestionSettings — an IdP
/// (Okta, Azure AD/Entra, OneLogin, ...) is configured with this org's SCIM base URL
/// (`/api/scim/:orgSlug/v2`) and the plaintext token shown once at generation time; every
/// subsequent SCIM request from the IdP carries that token as its bearer credential, checked
/// with `crypto.timingSafeEqual` the same way devops-webhook.controller.ts checks
/// IngestionSettings' token. Deliberately NOT tied to SsoConfig/OrgSsoConfig: an org can run
/// SCIM provisioning against an IdP without necessarily using that same IdP for SSO login (or
/// vice versa) — the two are related in practice but not coupled in this schema.
model ScimSettings {
  id             String   @id
  encryptedToken String?
  isEnabled      Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

/// Live git-provider OAuth connection — see docs/ROADMAP.md's "Live git-provider App
/// integration" item (the successor to the manual TicketBranch linking above). Singleton
/// (id = "global"), same upsert-by-constant-id pattern as IngestionSettings/GlobalAISettings —
/// one connected GitHub account per org for this phase, not per-project. `clientId`/
/// `encryptedClientSecret` are the org admin's OWN GitHub OAuth App credentials (same
/// bring-your-own-app-registration model OrgSsoConfig uses for Google/Microsoft SSO) — this
/// deployment never ships a shared GitHub App, so no GitHub org's data ever transits a
/// TimeSphere-operated OAuth client. `encryptedAccessToken` is the resulting user-to-server
/// token once the admin completes the OAuth handshake (services/git-provider.service.ts).
model GitConnection {
  id                     String    @id
  provider               String    @default("GITHUB") @db.VarChar(20)
  clientId               String?   @db.VarChar(255)
  encryptedClientSecret  String?   @db.VarChar(1000)
  encryptedAccessToken   String?   @db.VarChar(1000)
  /// Shared secret this org's admin pastes into EACH repo's GitHub webhook config (Settings ->
  /// repo -> Webhooks -> Secret) — GitHub Apps get one org-wide webhook, but a plain OAuth App
  /// only supports per-repo webhooks, so this one secret is reused across every repo the admin
  /// wires up. Same "shown once, rotating invalidates every existing config using it" trade-off
  /// as IngestionSettings.encryptedToken (see controllers/settings.controller.ts's
  /// /git/webhook-secret/rotate route) — there is no way around that for a secret configured
  /// into N external systems rather than held by this app alone.
  encryptedWebhookSecret String?   @db.VarChar(1000)
  /// The connected GitHub login (user or org) — display-only, refreshed on connect.
  accountLogin           String?   @db.VarChar(255)
  connectedById          String?
  connectedBy            User?     @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  connectedAt            DateTime?
  updatedAt              DateTime  @updatedAt
}

/// Public REST API key — see docs/ROADMAP.md's "Public REST API + outbound webhooks" theme
/// and docs/API.md's "Public API" section. Unlike IngestionSettings' one-token-per-org model,
/// an org can hold several named keys (one per external integration, independently revocable).
/// Only `keyHash` (SHA-256) is stored — same "never store the secret itself" posture as
/// Session.refreshHash and PasswordResetToken.tokenHash. `keyPrefix` (the first 8 chars of the
/// plaintext key) is stored in the clear purely so the UI can show "tsk_a1b2c3d4…" for the admin
/// to recognize which key is which without ever re-displaying the full value.
model ApiKey {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(120)
  keyHash     String    @unique @db.VarChar(64)
  keyPrefix   String    @db.VarChar(12)
  /// READ: GET endpoints only. WRITE: also allows POST /public/v1/tickets. No finer-grained
  /// scoping yet — see docs/ROADMAP.md for why a fuller scopes list is future work, not this
  /// phase.
  scope       String    @default("READ") @db.VarChar(10)
  lastUsedAt  DateTime?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([keyHash])
}

/// Outbound event notifications for external systems (Zapier, Make, a customer's own
/// integration) — the egress half of the "Public REST API + outbound webhooks" theme, the
/// ingress half being ApiKey above. Every delivery is HMAC-SHA256 signed with `secret` (see
/// services/webhook-dispatch.service.ts) so a receiver can verify a payload actually came from
/// this deployment, the same trust model GitHub/Stripe webhooks use.
model OutboundWebhook {
  id                 String    @id @default(uuid())
  name               String    @db.VarChar(120)
  url                String    @db.VarChar(500)
  secret             String    @db.VarChar(64)
  /// e.g. ["ticket.created","ticket.status_changed","ticket.closed","timesheet.submitted",
  /// "timesheet.approved"] — see webhook-dispatch.service.ts's WEBHOOK_EVENTS for the full list.
  /// Stored as a JSON array rather than a join table since the set is small and never queried
  /// by event across webhooks (each dispatch loop scans this org's own handful of webhooks).
  events             Json
  isActive           Boolean   @default(true)
  lastDeliveryAt     DateTime?
  lastDeliveryStatus String?   @db.VarChar(20)
  createdById        String?
  createdBy          User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
}

/// Singleton (id = "global"). Face (identity) verification — confirms the person submitting a
/// timesheet or ticket is the account holder, closing the "buddy punching" gap where a
/// colleague works on someone else's behalf using a shared/borrowed session.
///
/// Off by default, and deliberately so: this collects BIOMETRIC data, which is a special
/// category under GDPR Art.9, a written-consent-and-retention-policy matter under Illinois BIPA
/// (statutory damages per violation) and Texas CUBI, and sensitive personal data under India's
/// DPDP Act. Turning it on without the consent flow (see FaceEnrollment.consentAt) is a legal
/// exposure, not just a config choice — which is why enrollment refuses to proceed without
/// recorded consent rather than treating it as an optional nicety.
model GlobalFaceVerificationSettings {
  id      String  @id
  /// Master switch. Everything below is inert while this is false.
  enabled Boolean @default(false)

  /// Which actions demand a fresh face check.
  requireForTimesheet Boolean @default(true)
  requireForTicket    Boolean @default(false)

  /// ALL = every active user must enroll and verify.
  /// SELECTED = only users with User.faceVerificationRequired = true (the safe default, so
  /// switching `enabled` on doesn't instantly lock out a whole company mid-week).
  enforcementMode String @default("SELECTED") @db.VarChar(20)

  /// Cosine-ish similarity (0..1) from Human's faceres embeddings that counts as "same person".
  /// Calibrated against this model's real behaviour, not guessed: two DIFFERENT people score
  /// ~0.60-0.67, the same person across different captures ~0.83, an identical image 1.00. 0.75
  /// sits in that gap. Every attempt stores its own `similarity`, so an admin can look at the
  /// real distribution for their own workforce (Face verification log) and tune this rather than
  /// trusting a default picked on someone else's faces.
  matchThreshold Float @default(0.75)

  /// Human's antispoof ("real") and liveness ("live") scores, 0..1. These are what stop the
  /// obvious defeat of the whole feature — holding a printed photo or a phone showing the
  /// colleague's face up to the webcam. Both must clear their floor for a PASS.
  antispoofThreshold Float @default(0.5)
  livenessThreshold  Float @default(0.6)

  /// Consecutive failures before the attempt is flagged for admin review. Real face matching
  /// fails on bad lighting/new glasses/a dirty lens, so this blocks-then-escalates rather than
  /// hard-locking someone out of logging their own work.
  maxAttempts Int @default(3)

  /// How long a PASSED verification stays spendable, in seconds. Short by design: the point is
  /// to prove who is at the keyboard *right now*, so a capture can't be taken in the morning and
  /// reused all day.
  verificationTtlSeconds Int @default(300)

  /// Captured attempt images are deleted after this many days (0 = never store images at all,
  /// embeddings only). Bounds the biometric data actually sitting on disk while still leaving a
  /// window to investigate a disputed timesheet. Enforced by workers/face-retention.worker.ts.
  imageRetentionDays Int @default(30)

  /// Shown verbatim on the enrollment consent screen and copied onto each FaceEnrollment row, so
  /// there is a durable record of exactly what wording a person agreed to (BIPA-style
  /// "informed written consent" is about the specific disclosure, not a generic checkbox).
  consentText String? @db.Text

  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// One per user — the reference face this person is matched against. Created only through the
/// consent-gated enrollment route; deleting it (self-service or admin) is the "withdraw my
/// biometric data" path every biometric privacy regime requires.
model FaceEnrollment {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// AES-256-GCM ciphertext (utils/encryption.ts) of the base64'd Float32 embedding — never the
  /// raw vector. An embedding is biometric data in its own right under GDPR/BIPA, so it gets the
  /// same at-rest treatment as an API key rather than sitting in a plaintext column.
  /// Consequence, accepted deliberately: matching decrypts in Node and compares in-process, so
  /// there is no SQL-side vector search. Fine here — a verification compares against exactly ONE
  /// enrolled row (this user's), never a whole-table nearest-neighbour scan.
  encryptedEmbedding String @db.Text

  /// Which model produced the embedding. Embeddings are not comparable across model versions, so
  /// a model upgrade must force re-enrollment instead of silently comparing incompatible vectors
  /// and rejecting everyone.
  modelVersion String @db.VarChar(60)

  /// Stored under UPLOAD_DIR/face/<userId>/, served ONLY through an authenticated API route —
  /// never under the public /uploads static mount, which has no access control at all.
  referenceImagePath String? @db.VarChar(500)

  /// Consent record. `consentText` is the exact wording shown at the time, not a pointer to
  /// today's settings value (which an admin can edit later).
  consentAt   DateTime
  consentText String   @db.Text
  consentIp   String?  @db.VarChar(64)

  enrolledById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// One row per verification attempt — the audit trail, and the thing a timesheet/ticket submit
/// spends to prove identity was checked. Kept even for failures: "this person failed identity
/// check four times at 2am" is exactly the signal this feature exists to surface.
model FaceVerificationAttempt {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("FaceVerificationSubject", fields: [userId], references: [id], onDelete: Cascade)

  /// TIMESHEET | TICKET
  context String @db.VarChar(20)

  /// PASSED | NO_FACE | MULTIPLE_FACES | NO_MATCH | SPOOF_SUSPECTED | NOT_ENROLLED | ERROR
  outcome String @db.VarChar(30)

  /// The raw scores behind the decision, always recorded (even on failure) so a disputed
  /// rejection can be reviewed against numbers rather than re-run from memory.
  similarity    Float?
  antispoofReal Float?
  livenessScore Float?

  /// Captured frame, nulled by the retention worker after imageRetentionDays. Same
  /// authenticated-route-only rule as FaceEnrollment.referenceImagePath.
  imagePath String?   @db.VarChar(500)
  purgedAt  DateTime?

  /// Set when a PASSED attempt is redeemed by a timesheet/ticket submit. Single-use: a
  /// verification cannot be replayed across two submissions.
  consumedAt  DateTime?
  timesheetId String?   @db.VarChar(64)
  ticketId    String?   @db.VarChar(64)

  flaggedForReview Boolean   @default(false)
  reviewedById     String?
  reviewedBy       User?     @relation("FaceVerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  reviewNote       String?   @db.Text

  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([flaggedForReview, createdAt])
  @@index([outcome, createdAt])
  @@index([purgedAt])
}
