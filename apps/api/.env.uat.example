# UAT environment profile — copy to apps/api/.env.uat, fill in real values, then run with
# APP_ENV=uat (see docs/DEPLOYMENT.md § Environment profiles for the per-OS commands).
#
# Layering: values here WIN over apps/api/.env; anything you leave out falls back to .env.
# That means this file only needs the keys that genuinely differ per environment.
#
# UAT's job is to be production-shaped without production's blast radius: real SMTP (so email
# flows get tested) but pointed at test recipients, its own databases (NEVER share a database
# between environments — approvals and audit rows from a test run in prod data are
# unrecoverable), and NODE_ENV=production so the strict boot checks run here first.

NODE_ENV=production
TZ=Asia/Kolkata

# UAT's OWN databases, on whatever MySQL server hosts UAT. Distinct names make a mispointed
# connection obvious in any query log.
DATABASE_URL="mysql://timesphere_uat:CHANGE-ME@uat-db-host:3306/timesheet_portal_uat"
CONTROL_DATABASE_URL="mysql://timesphere_uat:CHANGE-ME@uat-db-host:3306/timesphere_control_uat"

# Distinct secrets per environment — a leaked UAT secret must be worthless in production.
# Generate: openssl rand -base64 48   (and openssl rand -hex 32 for the encryption key)
JWT_ACCESS_SECRET="CHANGE-ME-uat-access"
JWT_REFRESH_SECRET="CHANGE-ME-uat-refresh"
PLATFORM_ADMIN_JWT_SECRET="CHANGE-ME-uat-platform-admin"
ENCRYPTION_KEY="CHANGE-ME-64-hex-chars"

# The address testers actually open — a UAT subdomain, or a LAN box's https address.
WEB_ORIGIN="https://uat.timesphere.example.com"
APP_BASE_URL="https://uat.timesphere.example.com"

# Real SMTP so email flows are exercised, but from a UAT identity so a stray blast is
# self-identifying. Point test-user mailboxes at addresses you control.
MAIL_FROM="TimeSphere UAT <no-reply-uat@example.com>"
SMTP_HOST="smtp-relay.example.com"
SMTP_PORT=587
SMTP_USER="no-reply-uat@example.com"
SMTP_PASS="CHANGE-ME"
SMTP_SECURE=false

# Keep AI spend sandboxed: either a low-budget test key, or empty to keep AI inert in UAT.
ANTHROPIC_API_KEY=""
